{
  "name": "react-vite-tailwind",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:network": "vite --host 0.0.0.0 --port 5173",
    "backfill:project-ids": "node --experimental-strip-types scripts/backfill-projectIds.ts",
    "backfill:installations": "node --experimental-strip-types scripts/backfill-installations.ts",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "vite build",
    "preview": "vite preview",
    "demo:seed": "node --experimental-strip-types scripts/demo/seedDemoData.ts",
    "demo:plan": "node --experimental-strip-types scripts/demo/planDemoData.ts",
    "demo:verify": "node --experimental-strip-types scripts/demo/verifyDemoIsolation.ts",
    "demo:reset": "node --experimental-strip-types scripts/demo/resetDemoData.ts",
    "demo:reset:plan": "node --experimental-strip-types scripts/demo/planDemoReset.ts",
    "demo:cleanup": "node --experimental-strip-types scripts/demo/cleanupDemoData.ts",
    "test:rules": "firebase emulators:exec --only firestore --project neozy-demo-isolation-test \"vitest run --config vitest.emulator.config.ts\"",
    "demo:readiness": "node --experimental-strip-types scripts/demo/readiness.ts",
    "demo:help": "node --experimental-strip-types scripts/demo/help.ts",
    "test:demo": "vitest run src/lib/__tests__/demoTooling.test.ts src/lib/__tests__/demoBusinessGraph.test.ts src/lib/__tests__/demoFinalHardening.test.ts src/lib/__tests__/demoApiIsolation.test.ts src/lib/__tests__/demoSecurityRulesContract.test.ts src/lib/__tests__/demoPhase1Readiness.test.ts src/lib/__tests__/integrationPlatform.test.ts",
    "test:demo:e2e": "playwright test --config playwright.demo.config.ts"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.100.9",
    "@vercel/node": "^5.8.23",
    "clsx": "2.1.1",
    "date-fns": "^4.1.0",
    "firebase": "^12.12.1",
    "firebase-admin": "^14.1.0",
    "lucide-react": "^1.14.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hot-toast": "^2.6.0",
    "react-is": "^19.2.6",
    "react-router-dom": "^7.14.2",
    "recharts": "^3.8.1",
    "tailwind-merge": "3.4.0",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.1",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/vite": "4.1.17",
    "@types/node": "22.19.17",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.1",
    "firebase-tools": "^15.23.0",
    "playwright": "^1.61.1",
    "tailwindcss": "4.1.17",
    "typescript": "5.9.3",
    "vite": "^7.3.6",
    "vitest": "^4.1.10"
  }
}
