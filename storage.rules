rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function authMapPath() {
      return /databases/(default)/documents/user_auth_maps/$(request.auth.uid);
    }

    function currentUserId() {
      return signedIn() && firestore.exists(authMapPath())
        ? firestore.get(authMapPath()).data.userId
        : '';
    }

    function currentUserCompanyId() {
      return signedIn() && firestore.exists(authMapPath())
        ? firestore.get(authMapPath()).data.companyId
        : '';
    }

    // Phase 8 (Master Plan §9.5): parallel groupId lookup, identical
    // firestore.get()-based pattern to currentUserCompanyId() above. Mirrors
    // user_auth_maps.groupId (Phase 1, §3.2) — '' for a user with no Group
    // identity, which fails every GroupAdmin check below closed, not open.
    function currentUserGroupId() {
      return signedIn() && firestore.exists(authMapPath())
        ? firestore.get(authMapPath()).data.groupId
        : '';
    }

    // Mirrors firestore.rules' groupIsActive(): a suspended Group's
    // GroupAdmin must lose Storage access exactly as they lose Firestore
    // access (§9.6's stated principle, applied here for parity — the Master
    // Plan's §9.5 text doesn't spell this out explicitly, but leaving it out
    // would mean a suspended Group's GroupAdmin keeps pulling Storage
    // documents even though every Firestore read/write is already cut off).
    function groupIsActive(groupId) {
      return groupId is string && groupId.size() > 0
        && firestore.exists(/databases/(default)/documents/groups/$(groupId))
        && firestore.get(/databases/(default)/documents/groups/$(groupId)).data.status == 'Active';
    }

    // Phase 8 (§9.5): a GroupAdmin acts as Admin of any Company inside their
    // own, active Group (§5.2's "scope extension, not permission extension"
    // principle, mirrored to Storage) — never a caller-supplied companyId,
    // always the actor's own authoritative groupId from the auth-map chain.
    function isGroupAdminOfCompany(companyId) {
      return signedIn() && currentUserRole() == 'GroupAdmin'
        && firestore.exists(/databases/(default)/documents/companies/$(companyId))
        && firestore.get(/databases/(default)/documents/companies/$(companyId)).data.groupId == currentUserGroupId()
        && groupIsActive(currentUserGroupId());
    }

    function isOwnProfilePath(userId) {
      return signedIn() && currentUserId() == userId;
    }

    // ── Role + partner identity resolution (Firestore-backed, cached) ─────
    // Mirrors the Phase 1 identity model: the auth map resolves the ERP user
    // doc; users.channelPartnerId is the canonical partner link; a
    // channel_partners doc's managerId is the TL/Manager user id. Used by
    // the case/project document scope rules below — never a bare-company
    // path guess.
    function currentUserRole() {
      return signedIn() && firestore.exists(authMapPath())
        && firestore.exists(/databases/(default)/documents/users/$(currentUserId()))
        ? firestore.get(/databases/(default)/documents/users/$(currentUserId())).data.role
        : '';
    }

    function partnerDocPath(partnerId) {
      return /databases/(default)/documents/channel_partners/$(partnerId);
    }

    function selfPartnerId() {
      return signedIn()
        && firestore.exists(/databases/(default)/documents/users/$(currentUserId()))
        && firestore.get(/databases/(default)/documents/users/$(currentUserId())).data.keys().hasAny(['channelPartnerId'])
        && firestore.get(/databases/(default)/documents/users/$(currentUserId())).data.channelPartnerId is string
        ? firestore.get(/databases/(default)/documents/users/$(currentUserId())).data.channelPartnerId
        : '';
    }

    function isOwnerPartner(partnerId) {
      return partnerId is string && partnerId.size() > 0 && selfPartnerId() == partnerId;
    }

    function isManagerOfPartner(partnerId) {
      return partnerId is string && partnerId.size() > 0
        && firestore.exists(partnerDocPath(partnerId))
        && firestore.get(partnerDocPath(partnerId)).data.keys().hasAny(['managerId'])
        && firestore.get(partnerDocPath(partnerId)).data.managerId == currentUserId();
    }

    // GAP-01 remediation (independent Vendor Lock audit, 2026-08-14): the
    // Channel Partner spec (§7/§45, LOCKED) treats `TL` as behaviorally
    // equivalent to `Manager`; the JS canDo() layer already aliases
    // `tl -> Manager`, but this rules file compared the raw role string, so a
    // literal `role: 'TL'` never matched the Manager branch below and instead
    // fell through to the unrestricted "any other same-company staff" default
    // — broader than the intended team-scoped access. Scoped to the two
    // case/project document functions immediately below only.
    function isCaseDocManagerRole() {
      return currentUserRole() == 'Manager' || currentUserRole() == 'TL';
    }

    // The owning case/project document's partnerId ('' when the case/project
    // is not partner-owned — staff-managed records stay company-visible).
    function docPartnerId(docPath) {
      return firestore.exists(docPath) && firestore.get(docPath).data.keys().hasAny(['partnerId'])
        ? firestore.get(docPath).data.partnerId
        : '';
    }

    // Case/project document access (spec §15/§19). Cross-company denied.
    // Accounts denied. Partner: own case only. TL/Manager: their own
    // partner's case only. Director: view-only (read, no write). Any other
    // same-company staff: existing behavior preserved (company access).
    // NOTE (Phase 8 discovery): these two functions previously used an
    // imperative `if (cond) return x;` chain. That is NOT valid Cloud
    // Storage Rules syntax (unlike Firestore Rules' newer dialect, the
    // Storage Rules runtime only accepts a single ternary-chain return
    // expression per function) — the real Storage Rules emulator rejects it
    // with a parse error at deploy/test time. This had never been caught
    // because no real Storage Rules emulator test existed before Phase 8
    // (the two prior "storage rules" tests were readFileSync() string/regex
    // assertions, not actual rules evaluation). Rewritten below as an
    // equivalent ternary chain — same priority-ordered decision logic,
    // same outcome for every case, now syntactically valid.
    function canReadScopedDocuments(companyId, docPath) {
      // Phase 8 (§9.5): GroupAdmin reads any Company in their own active
      // Group as if they were that Company's Admin (§5.2) — checked before
      // the same-company gate, which would otherwise deny a sibling Company.
      return !signedIn() ? false
        : isGroupAdminOfCompany(companyId) ? true
        : currentUserCompanyId() != companyId ? false
        : currentUserRole() == 'Accounts' ? false
        : currentUserRole() == 'Admin' ? true
        : isCaseDocManagerRole() ? isManagerOfPartner(docPartnerId(docPath))
        : currentUserRole() == 'Partner' ? isOwnerPartner(docPartnerId(docPath))
        : true;
    }

    function canWriteScopedDocuments(companyId, docPath) {
      return !signedIn() ? false
        : isGroupAdminOfCompany(companyId) ? true
        : currentUserCompanyId() != companyId ? false
        : (currentUserRole() == 'Accounts' || currentUserRole() == 'Director') ? false
        : currentUserRole() == 'Admin' ? true
        : isCaseDocManagerRole() ? isManagerOfPartner(docPartnerId(docPath))
        : currentUserRole() == 'Partner' ? isOwnerPartner(docPartnerId(docPath))
        : true;
    }

    // NOTE (Phase 8 discovery): the exclusion of scoped-document paths from
    // the general company catch-all below previously used
    // `allPaths.matches('cases/.*/documents/.*')` / `.split('/')`. The real
    // Storage Rules runtime this project's emulator downloads
    // (cloud-storage-rules-runtime-v1.1.3.jar) rejects BOTH `.matches()` and
    // `.split()` at evaluation time ("Function not found error") — and
    // because a thrown/errored rules expression evaluates to deny (not a
    // distinctly-surfaced failure), this silently made EVERY request through
    // the general `companies/{companyId}/{allPaths=**}` catch-all fail
    // closed unconditionally, not just scoped-document paths (products,
    // surveys, engineering designs, commissioning signatures, everything).
    // This had never been caught because no real Storage Rules emulator test
    // existed before Phase 8. Fixed below by capturing the first path
    // segment natively in the match PATTERN itself (guaranteed-supported
    // routing, not a runtime string method) instead of parsing `allPaths` at
    // evaluation time — see the two `companies/{companyId}/...` match blocks
    // after the scoped-document blocks. Verified against every real
    // `src/lib/storage.ts`/feature-module upload call site that nothing is
    // ever written under a `cases/{id}/...` or `projects/{id}/...` path
    // other than the `.../documents/{fileName}` shape, so excluding by first
    // segment alone (`cases`/`projects`) is behaviorally identical to the
    // original three/four-segment-specific regex for every path this
    // application actually uses.

    match /users/{userId}/profile/{allPaths=**} {
      allow read, write: if isOwnProfilePath(userId);
    }

    // ── Case-scoped Registration documents (spec §15 — the required
    // conceptual path) ── ownership resolves through the owning case.
    match /companies/{companyId}/cases/{caseId}/documents/{fileName} {
      allow read: if canReadScopedDocuments(companyId, /databases/(default)/documents/cases/$(caseId));
      allow write: if canWriteScopedDocuments(companyId, /databases/(default)/documents/cases/$(caseId));
    }

    // ── Project-scoped documents (fallback when a project has no caseId) ──
    match /companies/{companyId}/projects/{projectId}/documents/{fileName} {
      allow read: if canReadScopedDocuments(companyId, /databases/(default)/documents/projects/$(projectId));
      allow write: if canWriteScopedDocuments(companyId, /databases/(default)/documents/projects/$(projectId));
    }

    function canAccessGeneralCompanyPath(companyId) {
      // Phase 8 (§9.5): additive-OR, never a rewrite of the existing
      // same-company clause (Master Plan §16.2 rule 4) — a GroupAdmin gains
      // access to sibling Companies in their own active Group; the original
      // same-company behavior for every other actor is unchanged.
      return signedIn() && (currentUserCompanyId() == companyId || isGroupAdminOfCompany(companyId));
    }

    // A direct file immediately under companies/{companyId}/ (no
    // intermediate folder) — cannot be a cases/projects scoped-document path.
    match /companies/{companyId}/{singleSegment} {
      allow read, write: if canAccessGeneralCompanyPath(companyId);
    }

    // Any deeper path EXCEPT one whose first segment is 'cases' or
    // 'projects' (those are exclusively governed by the two scoped-document
    // match blocks above — see the NOTE above this section for why the
    // exclusion is by first-segment, not the original regex).
    match /companies/{companyId}/{first}/{rest=**} {
      allow read, write: if !(first == 'cases' || first == 'projects') && canAccessGeneralCompanyPath(companyId);
    }

    match /integration-secrets/{allPaths=**} {
      allow read, write: if false;
    }
  }
}
