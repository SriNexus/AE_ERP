rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwnerIdentity() {
      return signedIn()
        && request.auth.token.email is string
        && request.auth.token.email == 'shreeniwas.tripathi0@gmail.com';
    }

    function authMapPath() {
      return /databases/$(database)/documents/user_auth_maps/$(request.auth.uid);
    }

    function hasAuthMap() {
      return signedIn() && exists(authMapPath());
    }

    function currentUserId() {
      return isOwnerIdentity() ? 'owner:' + request.auth.uid : (hasUserProfile() ? get(authMapPath()).data.userId : '');
    }

    // LEAN currentUser(): reads the actor's ERP users doc via the mapping's
    // userId (users/{map.userId}) — the SAME doc the login resolver selected
    // (authIdentity.resolveAuthenticatedErpUser). For uid-keyed users the map
    // userId == auth.uid (identical doc); for master-identity users it is the
    // users/MUSR-{companyId}-{phone} doc. The mapping is self-owned and
    // validated at write time (validOwnMapping) and at read time
    // (hasValidAuthMap verifies the target exists with the token email + map
    // companyId), so the mapped doc is the canonical identity, never a guess.
    // Single get() (engine-cached across clauses) keeps the rule under the
    // 1000-expression budget; the pre-flattening indirection multiplied the
    // budget ~6-8x in rules that call currentUser() several times
    // (isAdmin -> isSuperAdmin -> currentUser, roleMatches x4) and silently
    // denied legitimate updates/reads (live-bisect F4/G2/J2/K3).
    function currentUser() {
      return get(/databases/$(database)/documents/users/$(get(authMapPath()).data.userId)).data;
    }

    // LEAN identity core. The Rules engine counts every sub-expression toward
    // the 1000-expression per-request budget, and repeated helper invocation
    // (isAdmin -> isSuperAdmin -> hasUserProfile -> ...) multiplies the cost.
    // Two principles keep every rule under budget:
    //   1. The mapping doc (user_auth_maps/{authUid}) is validated AT WRITE
    //      TIME by validOwnMapping (keys whitelist, email matches the token,
    //      and the referenced users doc exists with matching email+companyId),
    //      and users docs can never be deleted (allow delete: if false) nor
    //      have companyId changed by Admins — so reads only need to re-anchor
    //      the mapping's userId/companyId/email to the signed-in token.
    //   2. Company identity is read from the MAPPING (cheap, cached) instead
    //      of re-walking the users doc via currentUser() (extra get).
    // The actor's ERP identity is the MAPPING's userId. For master-identity
    // users (users/MUSR-{companyId}-{phone} — the canonical production shape
    // for real accounts) that id legitimately differs from the Firebase Auth
    // UID, so the old `userId == request.auth.uid` anchor denied EVERY
    // company-scoped rule for real users (live-bisect: Admin settings + user
    // aggregation 403 storm with a fully-correct tenant context; the 82/82
    // battery passed only because its UAT users were uid-keyed). The binding
    // that matters is EMAIL + tenant: the mapping (self-owned —
    // user_auth_maps/{authUid} can only be written by that UID, validated by
    // validOwnMapping, which requires the mapped users doc to EXIST with the
    // token email + map companyId) must carry the verified token email.
    // NOTE: the mapped users doc is intentionally NOT re-verified at read
    // time — the email/company coherence is enforced at the WRITE boundary
    // (validOwnMapping) and the login resolver; re-reading it here pushed
    // roleMatches/canReadProjectScoped past the 1000-expression budget
    // (live-bisect F4/G2/J2/K3 403 on legitimate requests, 78/82 battery).
    function hasValidAuthMap() {
      return signedIn()
        && hasAuthMap()
        && get(authMapPath()).data.userId is string
        && get(authMapPath()).data.companyId is string
        && get(authMapPath()).data.email == request.auth.token.email;
    }

    function hasUserProfile() {
      return hasValidAuthMap();
    }

    // ROOT CAUSE (real production report, reproduced live: a Group Admin's
    // account, and any other account created/migrated before isSuperAdmin
    // was always stamped, has NO isSuperAdmin field on its users/{id} doc at
    // all — confirmed by direct field dump of the real reported account).
    // currentUser().isSuperAdmin == true, unguarded, is exactly the
    // undefined-map-field-access class this file's own comments repeatedly
    // warn about elsewhere (hasGroupId/hasCompanyId/roleNotSystemProtected
    // all guard with keys().hasAny() first) — reproduced directly against
    // the emulator with the exact real (field-absent) document: evaluating
    // isSuperAdmin() denied EVERY rule that calls isAdmin() (which calls
    // this) for that actor, including a trivial roles/{id} field update,
    // by exhausting the 1000-expression budget rather than short-circuiting
    // cleanly to false. The FIRST fix used the keys().hasAny()+field-access
    // two-step pattern (this file's usual convention) — correct, but its
    // extra expression-node cost, multiplied across this function's several
    // real call sites plus the users/{userId} rule's OWN two stacked `allow
    // update` statements plus the emulator's documented wildcard-fallback
    // re-evaluation, was enough on its own to blow the 1000-expression
    // budget on a live-reproduced payload (department+role changed
    // together) that was already right at the edge before this fix existed.
    // map.get(key, default) is Firestore Rules' own single-expression,
    // budget-cheaper way to read a possibly-absent field (confirmed valid
    // and working against the emulator this session) — used here instead.
    function isSuperAdmin() {
      return isOwnerIdentity()
        || (hasUserProfile() && currentUser().get('isSuperAdmin', false) == true);
    }

    // F-13 (Phase 0, Master Plan §9.2): an "active" actor. A deactivated user
    // (status in the inactive set — BOTH the lowercase canonical forms from
    // authIdentity.validateProfile AND the capitalized forms the Users UI
    // actually writes, 'Inactive'/'Suspended') or a soft-deleted user loses all
    // rules-level access. isOwnerIdentity() remains an unconditional bypass
    // (the owner's identity comes from the signed token, never the users doc).
    // Every optional-field read gates on keys().hasAny() first (fail-closed idiom).
    function actorIsActive() {
      return isOwnerIdentity()
        || (hasUserProfile()
          && !(currentUser().keys().hasAny(['status']) && currentUser().status in ['inactive', 'suspended', 'disabled', 'Inactive', 'Suspended', 'Disabled'])
          && !(currentUser().keys().hasAny(['isDeleted']) && currentUser().isDeleted == true));
    }

    // NOTE (F-13 budget engineering): actorIsActive() is intentionally NOT
    // embedded in isAdmin()/isSuperAdmin()/roleMatches() — those helpers are
    // invoked NESTED inside canReadProjectScoped()/schemeRegCanRead() etc., and
    // every nested invocation re-counts the function body toward the
    // 1000-expression-per-request budget (the same live-bisected multiplier
    // class documented above — F4/G2/J2/K3). The active-actor gate lives in
    // the can*CompanyScoped()/canReadProjectScoped()/canSeeNotification()/
    // schemeRegCanRead() helpers plus the explicit top-level clauses that call
    // isAdmin()/isSuperAdmin()/roleMatches() directly. This keeps the gate
    // evaluated ONCE per allow clause instead of ~3-4x per nested chain.
    function isAdmin() {
      return isOwnerIdentity() || isSuperAdmin() || (hasUserProfile() && currentUser().role == 'Admin');
    }

    function roleMatches(pattern) {
      return hasUserProfile() && currentUser().role.matches(pattern);
    }

    // GAP-01 remediation (independent Vendor Lock audit, 2026-08-14): the
    // Channel Partner spec (§7/§45, LOCKED) treats `TL` as behaviorally
    // equivalent to `Manager` for the Channel Partner / Registration domain;
    // permissions.ts already aliases `tl -> Manager` at the JS canDo() layer,
    // but that alias never reached the rules text, so a literal `role: 'TL'`
    // failed every roleMatches('Manager') check in the scheme_registrations
    // block below. Scoped deliberately to that block only — do not reuse for
    // unrelated roleMatches('Manager') checks elsewhere in this file without
    // separately auditing them (out of Vendor Lock scope).
    function isSchemeRegManagerRole() {
      return roleMatches('Manager') || roleMatches('TL');
    }

    function userCompanyId() {
      return hasUserProfile() ? get(authMapPath()).data.companyId : '';
    }

    function hasCompanyId(data) {
      return data.companyId is string && data.companyId.size() > 0;
    }

    // Cheap-first ordering: the same-company branch short-circuits before
    // the (heavier) super-admin check for the common in-tenant case.
    // Phase 2 (§9.6): the same-company branch also requires the company's
    // owning Group to exist and be Active — suspending a Group suspends its
    // Company Admins too (deliberate, platform-wide behavior change called
    // out explicitly in the plan). Owner/Super Admin bypass unconditionally
    // (break-glass). companyGroupIsActive's gets are engine-cached and only
    // evaluated on this branch, keeping the common path bounded.
    function sameCompany(data) {
      return isOwnerIdentity()
        || (hasCompanyId(data) && data.companyId == userCompanyId() && companyGroupIsActive(data))
        || isSuperAdmin();
    }

    function companyIdUnchanged() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['companyId']);
    }

    // ── Phase 2 (Multi-Tenant, Master Plan §9.1) — Group tier helpers ────────
    // GroupAdmin is a SCOPE extension, not a permission extension (§5.2): a
    // Group Admin's grants are the target Company's own Admin role grants. The
    // rules below only extend WHICH documents a GroupAdmin can reach (their
    // whole Group), never what they can do on them (that stays role/permission
    // driven). Every helper is lean: identity reads come from the cached auth
    // map + currentUser() chain (the same single-get pattern documented above),
    // and all optional-field reads gate on keys().hasAny() first (the
    // fail-closed missing-field idiom used throughout this file).

    // The GroupAdmin's authoritative Group, read from the auth map's
    // denormalized groupId (Phase 1 §3.2 — mirrors users.groupId, validated at
    // write time by validOwnMapping). '' when absent (no group authority) — a
    // GroupAdmin without a groupId in their mapping resolves no cross-company
    // scope and fails closed everywhere, exactly like a missing companyId.
    //
    // LEAN (§13 expression budget): reads come from hasAuthMap() + the cached
    // auth-map path ONLY — deliberately NOT hasUserProfile()/hasValidAuthMap()/
    // currentUser(), whose re-entry re-counts the whole identity chain toward
    // the 1000-expression budget on every GroupAdmin-branch evaluation (the
    // same multiplier class live-bisected as F4/G2/J2/K3). The map's groupId
    // was validated at write time by validOwnMapping, so the anchor is the
    // self-owned mapping, exactly like userCompanyId().
    function actorGroupId() {
      return hasAuthMap()
        && get(authMapPath()).data.keys().hasAny(['groupId'])
        && get(authMapPath()).data.groupId is string
        ? get(authMapPath()).data.groupId : '';
    }

    // LEAN GroupAdmin identity: the mapped users doc's role, reached through
    // the cached auth-map userId — no hasValidAuthMap()/currentUser() re-entry.
    function actorIsGroupAdmin() {
      return hasAuthMap()
        && get(authMapPath()).data.userId is string
        && get(/databases/$(database)/documents/users/$(get(authMapPath()).data.userId)).data.role == 'GroupAdmin';
    }

    // §9.1 naming-compatible alias (isGroupAdmin() is the plan's name; the
    // implementation stays lean).
    function isGroupAdmin() {
      return actorIsGroupAdmin();
    }

    // Mirrors hasCompanyId()/hasManagerId() exactly: a missing groupId field
    // must yield false (clause skipped), never a hard rules denial.
    function hasGroupId(data) {
      return data.keys().hasAny(['groupId']) && data.groupId is string && data.groupId.size() > 0;
    }

    // Master Plan §9.1. sameGroup() is the additive-OR condition: owner /
    // super-admin bypass unconditionally (platform tier), otherwise the actor
    // must be a GroupAdmin whose authoritative group equals the target
    // document's groupId. The document's groupId is the denormalized,
    // write-time-stamped field (§3.2) — never a client-claimed value, because
    // every write helper strips client-supplied groupId and re-stamps the
    // authoritative one (§3.4, Phase 1).
    function sameGroup(data) {
      return isOwnerIdentity()
        || isSuperAdmin()
        || (isGroupAdmin() && hasGroupId(data) && data.groupId == actorGroupId());
    }

    // Group suspension (§9.6): a suspended Group loses ALL access — its users
    // (including its Group Admins and its Company Admins) are denied at the
    // rules layer; Super Admin retains break-glass access (isSuperAdmin() /
    // isOwnerIdentity() bypass sameGroup/sameCompany before this is consulted).
    function groupIsActive(groupId) {
      return groupId is string && groupId.size() > 0
        && exists(/databases/$(database)/documents/groups/$(groupId))
        && get(/databases/$(database)/documents/groups/$(groupId)).data.status == 'Active';
    }

    // §9.6: sameCompany() gains a group-suspension check — the actor's OWN
    // company access also requires the company's owning Group to exist and be
    // Active (looks up companies/{companyId}.groupId, then groups/{groupId}).
    // This is the one place Phase 2 deliberately changes existing Company-tier
    // behavior: suspending a Group suspends everyone under it. The gets are
    // engine-cached and only evaluated on the same-company branch (the common
    // in-tenant case), keeping the expression cost bounded.
    function companyGroupIsActive(data) {
      return hasCompanyId(data)
        && exists(/databases/$(database)/documents/companies/$(data.companyId))
        && get(/databases/$(database)/documents/companies/$(data.companyId)).data.keys().hasAny(['groupId'])
        && groupIsActive(get(/databases/$(database)/documents/companies/$(data.companyId)).data.groupId);
    }

    // Lean additive-OR composites for the §9.3 pattern. The plan's literal
    // pattern is `isGroupAdmin() && sameGroup(data)` — the owner/super-admin
    // terms inside sameGroup() are redundant here because the primary
    // can*CompanyScoped() branch already covers them; these composites keep
    // the expression budget bounded while preserving the exact same
    // semantics for the GroupAdmin branch. groupIsActive() is included per
    // §9.6 (every sameGroup-gated clause additionally requires the Group to
    // be Active). Cheap doc-field checks are ordered FIRST so non-GroupAdmin
    // actors and non-matching docs short-circuit before the identity reads.
    function groupAdminCanRead(data) {
      return hasGroupId(data)
        && groupIsActive(data.groupId)
        && data.groupId == actorGroupId()
        && actorIsGroupAdmin();
    }

    // §3.2 data integrity (Phase 2): a tenant-scoped write's groupId (when
    // present) must equal the owning Company's group — a forged/contradictory
    // groupId can never plant a cross-Group reference or leak a document into
    // another Group's GroupAdmin reach. A write WITHOUT groupId is accepted
    // (pre-backfill window / legacy direct writes — the Phase 1 posture). For
    // same-company writes the companies get() is already in flight
    // (companyGroupIsActive) and engine-cached; for GroupAdmin writes it is
    // one bounded get() on the write path only (never the read path).
    function groupIdMatchesCompany(data) {
      return !hasGroupId(data)
        || (hasCompanyId(data)
          && exists(/databases/$(database)/documents/companies/$(data.companyId))
          && get(/databases/$(database)/documents/companies/$(data.companyId)).data.keys().hasAny(['groupId'])
          && data.groupId == get(/databases/$(database)/documents/companies/$(data.companyId)).data.groupId);
    }

    function groupAdminCanCreate(data) {
      return hasGroupId(data)
        && groupIsActive(data.groupId)
        && data.groupId == actorGroupId()
        && actorIsGroupAdmin()
        && groupIdMatchesCompany(data);
    }

    // Mirror of companyIdUnchanged(): groupId is denormalized and immutable at
    // write time (§3.2) — a direct update can never re-point a document's Group.
    function groupIdUnchanged() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['groupId']);
    }

    // §9.3 update pattern: sameGroup(resource) && sameGroup(request) &&
    // groupIdUnchanged(), PLUS companyIdUnchanged() — §3.2 declares BOTH
    // tenant-ownership fields (companyId AND groupId) Required+Immutable on
    // every tenant-scoped collection, so a GroupAdmin update can never
    // re-point a business document to another Company (even within their own
    // Group). The one deliberate exception is `users`, whose GroupAdmin
    // update branch handles same-Group Company transfer explicitly (§4.4).
    function groupAdminCanUpdate(data) {
      return hasGroupId(data) && hasGroupId(request.resource.data)
        && groupIdUnchanged()
        && companyIdUnchanged()
        && groupIsActive(data.groupId)
        && data.groupId == actorGroupId()
        && request.resource.data.groupId == actorGroupId()
        && actorIsGroupAdmin()
        && groupIdMatchesCompany(request.resource.data);
    }

    // ── Phase 3 (F-07) — Warehouse tier helpers ───────────────────────────
    // Master Plan §8.1/§8.2: a NEW warehouse-level authorization scope. A
    // user whose role is warehouse-operational (role matches Warehouse /
    // Operations — the existing warehouse-adjacent roles the rules already
    // gate with roleMatches('.*Warehouse.*')/'roleMatches('.*Operations.*')
    // on stock qty / dispatch confirmation) and who carries a warehouseId
    // assignment is scoped by sameWarehouse() on the warehouse-scoped
    // collections (stock, dispatch, goods_receipts). Every other role is
    // unaffected (§8.2/§8.4): Admin/GroupAdmin/Director/Manager retain full
    // Company/Group-wide warehouse visibility, and owner/Super Admin bypass
    // unconditionally (break-glass). A warehouse-operational role with NO
    // warehouseId assignment FAILS CLOSED (no warehouse scope to resolve).
    //
    // LEAN (§13 expression budget): identity reads come from the cached
    // auth-map → users-doc chain (the same single-get pattern as the Phase 2
    // Group helpers); role matching mirrors the existing roleMatches() regex
    // usage on these same collections; optional-field reads gate on
    // keys().hasAny() first (the fail-closed missing-field idiom).

    // The actor's authoritative warehouse, from their own users doc
    // (users.warehouseId, §8.2 — a singular field, never an array). '' when
    // absent → sameWarehouse() can never match → fail closed.
    function actorWarehouseId() {
      return hasAuthMap()
        && get(authMapPath()).data.userId is string
        && get(/databases/$(database)/documents/users/$(get(authMapPath()).data.userId)).data.keys().hasAny(['warehouseId'])
        && get(/databases/$(database)/documents/users/$(get(authMapPath()).data.userId)).data.warehouseId is string
        ? get(/databases/$(database)/documents/users/$(get(authMapPath()).data.userId)).data.warehouseId : '';
    }

    // §8.2: warehouse-operational roles (regex, matching the existing
    // roleMatches('.*Warehouse.*')/'roleMatches('.*Operations.*') gates on
    // the same collections). Role check only — the warehouseId presence is
    // enforced by sameWarehouse() (fail closed when missing).
    function actorIsWarehouseRestricted() {
      return hasAuthMap()
        && get(authMapPath()).data.userId is string
        && (get(/databases/$(database)/documents/users/$(get(authMapPath()).data.userId)).data.role.matches('.*Warehouse.*')
          || get(/databases/$(database)/documents/users/$(get(authMapPath()).data.userId)).data.role.matches('.*Operations.*'));
    }

    // Mirrors hasCompanyId()/hasGroupId() exactly: a missing/non-string
    // warehouseId must yield false (clause skipped), never a hard denial.
    function hasWarehouseId(data) {
      return data.keys().hasAny(['warehouseId']) && data.warehouseId is string && data.warehouseId.size() > 0;
    }

    // LEAN Super Admin check for the warehouse gate: reads the mapped users
    // doc directly through the cached auth-map path (the actorIsGroupAdmin()
    // pattern) instead of re-entering hasValidAuthMap()/currentUser() — the
    // F4/G2/J2/K3 multiplier class. Preserves the §8.4 break-glass exactly.
    function actorIsSuperAdmin() {
      return isOwnerIdentity()
        || (hasAuthMap()
          && get(authMapPath()).data.userId is string
          && get(/databases/$(database)/documents/users/$(get(authMapPath()).data.userId)).data.keys().hasAny(['isSuperAdmin'])
          && get(/databases/$(database)/documents/users/$(get(authMapPath()).data.userId)).data.isSuperAdmin == true);
    }

    // §8.1 sameWarehouse(): the target document's warehouseId equals the
    // actor's assigned warehouse. Owner/Super Admin bypass unconditionally
    // (platform tier, §8.4 break-glass); non-warehouse-restricted actors pass
    // through. ONE LEAN PASS over the cached auth-map → users-doc chain — the
    // actorIsGroupAdmin() pattern, deliberately NOT the separate
    // actorIsSuperAdmin()/actorIsWarehouseRestricted()/actorWarehouseId()
    // helper invocations, whose repeated hasAuthMap()/get(authMapPath())/
    // get(users/...) calls multiplied toward the 1000-expression budget on the
    // stacked write rules (the F4/G2/J2/K3 class, same live-bisected fix as
    // Phase 2's groupAdminCanRead). actorWarehouseScopeIsAny() answers "does
    // the warehouse gate apply?" with the isSuperAdmin + role reads inlined;
    // the restricted actor's warehouseId is resolved in a second call ONLY
    // when the gate applies. A warehouse-operational role with NO warehouseId
    // assignment fails closed ('' can never equal a real id).
    function actorWarehouseScopeIsAny() {
      return isOwnerIdentity()
        || !hasAuthMap()
        || !(get(authMapPath()).data.userId is string)
        || (get(/databases/$(database)/documents/users/$(get(authMapPath()).data.userId)).data.keys().hasAny(['isSuperAdmin'])
          && get(/databases/$(database)/documents/users/$(get(authMapPath()).data.userId)).data.isSuperAdmin == true)
        || !(get(/databases/$(database)/documents/users/$(get(authMapPath()).data.userId)).data.keys().hasAny(['role'])
          && (get(/databases/$(database)/documents/users/$(get(authMapPath()).data.userId)).data.role.matches('.*Warehouse.*')
            || get(/databases/$(database)/documents/users/$(get(authMapPath()).data.userId)).data.role.matches('.*Operations.*')));
    }

    function actorWarehouseScopeId() {
      return get(/databases/$(database)/documents/users/$(get(authMapPath()).data.userId)).data.keys().hasAny(['warehouseId'])
        && get(/databases/$(database)/documents/users/$(get(authMapPath()).data.userId)).data.warehouseId is string
        ? get(/databases/$(database)/documents/users/$(get(authMapPath()).data.userId)).data.warehouseId : '';
    }

    // LEAN role check for the warehouse-scoped write rules' role gates
    // (e.g. the stock qty-update branch): reads the mapped users doc directly
    // through the cached auth-map path instead of roleMatches()/isAdmin(),
    // which re-enter hasUserProfile()/currentUser() (the F4/G2/J2/K3 class).
    function actorRoleMatches(pattern) {
      return hasAuthMap()
        && get(authMapPath()).data.userId is string
        && get(/databases/$(database)/documents/users/$(get(authMapPath()).data.userId)).data.keys().hasAny(['role'])
        && get(/databases/$(database)/documents/users/$(get(authMapPath()).data.userId)).data.role.matches(pattern);
    }

    function sameWarehouse(data) {
      return actorWarehouseScopeIsAny()
        || (hasWarehouseId(data) && data.warehouseId == actorWarehouseScopeId());
    }

    // F-08-class FK validation (Master Plan Phase 3 scope: "warehouseId FK
    // validation on write"): the referenced warehouse must EXIST and belong
    // to the same Company as the document — a forged cross-company reference
    // (companyId: COMPANY_A, warehouseId: WAREHOUSE_B where WAREHOUSE_B
    // belongs to COMPANY_C) is rejected. Same exists()+get() technique as the
    // group/company FK checks elsewhere in this file.
    function warehouseBelongsToCompany(data) {
      return hasWarehouseId(data)
        && exists(/databases/$(database)/documents/warehouses/$(data.warehouseId))
        && get(/databases/$(database)/documents/warehouses/$(data.warehouseId)).data.keys().hasAny(['companyId'])
        && get(/databases/$(database)/documents/warehouses/$(data.warehouseId)).data.companyId == data.companyId;
    }

    // warehouseId is immutable once a warehouse-scoped document is created —
    // a direct update can never re-point a stock/dispatch/goods-receipts
    // record at another warehouse (mirrors companyIdUnchanged()/groupIdUnchanged()).
    function warehouseIdUnchanged() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['warehouseId']);
    }

    // LEAN actor userId for the write-path anchoring gates (createdBy /
    // receivedBy == currentUserId()): the full currentUserId() re-enters
    // hasUserProfile()/hasValidAuthMap() (the F4/G2/J2/K3 multiplier class);
    // this reads the self-owned mapping directly, preserving the owner
    // pseudo-id ('owner:{uid}') and the fail-closed '' for absent mappings.
    function actorUserId() {
      return isOwnerIdentity() ? 'owner:' + request.auth.uid
        : (hasAuthMap() && get(authMapPath()).data.userId is string ? get(authMapPath()).data.userId : '');
    }

    // LEAN Phase 3 write-scope composites for the warehouse-scoped collections
    // (stock / stock_ledger / dispatch / goods_receipts). The same-company
    // branch uses the DIRECT companyId comparison + the §9.6 Group-active gate
    // instead of the full sameCompany() chain — the documented F4/G2/J2/K3
    // expression multiplier — because the Phase 3 warehouse gates stacked on
    // top (warehouseBelongsToCompany + sameWarehouse + createdBy/receivedBy
    // anchoring) push the full chain over the 1000-expression budget on the
    // write path. CHEAPEST-FIRST ordering (the Phase 2 users-list winning
    // shape): isOwnerIdentity (token) → the direct same-company comparison →
    // the super-admin check LAST so it short-circuits for in-tenant actors —
    // actorIsSuperAdmin/hasUserProfile must NOT be evaluated before the direct
    // branch, or their re-entered identity reads re-count toward the budget on
    // every in-tenant write. The GroupAdmin additive-OR is unchanged (§5.2).
    function warehouseActorCanCreate(data) {
      return isOwnerIdentity()
        || (hasAuthMap()
          && get(authMapPath()).data.keys().hasAny(['companyId'])
          && get(authMapPath()).data.companyId is string
          && data.companyId == get(authMapPath()).data.companyId
          && companyGroupIsActive(data) && groupIdMatchesCompany(data))
        || actorIsSuperAdmin()
        || groupAdminCanCreate(data);
    }

    function warehouseActorCanUpdate(existing) {
      return isOwnerIdentity()
        || (hasAuthMap()
          && get(authMapPath()).data.keys().hasAny(['companyId'])
          && get(authMapPath()).data.companyId is string
          && existing.companyId == get(authMapPath()).data.companyId
          && companyGroupIsActive(existing) && companyIdUnchanged()
          && groupIdMatchesCompany(request.resource.data))
        || actorIsSuperAdmin()
        || groupAdminCanUpdate(existing);
    }

    // §5.6: roles stay Company-scoped (F-03 keying), and a Group Admin reads a
    // target Company's role documents through the sameGroup()-extended access
    // pattern as every other Company-scoped collection. Role docs carry
    // companyId (never groupId — §3.2 excludes `roles` from the groupId
    // denormalization), so the Group's identity is resolved through the
    // Company: companies/{companyId}.groupId == actorGroupId(), with the
    // Group-active gate (§9.6). Single get() on the companies doc,
    // engine-cached, evaluated only for GroupAdmin actors. Actor check LAST
    // (cheapest-first) so non-GroupAdmin reads short-circuit on the doc.
    function groupAdminCanReadRole(data) {
      return hasCompanyId(data)
        && data.companyId.size() > 0
        && exists(/databases/$(database)/documents/companies/$(data.companyId))
        && get(/databases/$(database)/documents/companies/$(data.companyId)).data.keys().hasAny(['groupId'])
        && get(/databases/$(database)/documents/companies/$(data.companyId)).data.groupId == actorGroupId()
        && groupIsActive(get(/databases/$(database)/documents/companies/$(data.companyId)).data.groupId)
        && actorIsGroupAdmin();
    }

    // §4.4 users lifecycle: a Group Admin creates/transfers users into any
    // Company of their own Group. The requested companyId must belong to the
    // actor's authoritative Group (companies/{companyId}.groupId ==
    // actorGroupId()) — a forged companyId pointing into another Group is
    // rejected. Single get(), engine-cached, GroupAdmin actors only.
    function groupAdminUserCompanyMatches(data) {
      return hasCompanyId(data)
        && exists(/databases/$(database)/documents/companies/$(data.companyId))
        && get(/databases/$(database)/documents/companies/$(data.companyId)).data.keys().hasAny(['groupId'])
        && get(/databases/$(database)/documents/companies/$(data.companyId)).data.groupId == actorGroupId();
    }

    function selfAccessFieldsUnchanged() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'displayName', 'email', 'phone', 'avatarUrl', 'signatureUrl', 'updatedAt', 'updatedBy']);
    }

    // ── Data-driven section model (manager-department coherence) ────────────
    // A user's department is the department of their role; users docs carry a
    // denormalized department + isManager (recomputed by the canonical user
    // hook at every write). A reporting manager must be the report's own
    // manager, a super-admin, or a manager-role holder in the same company,
    // the same department / the cross-section 'Management' layer. This blocks
    // invalid combinations server-side (e.g. Sales Executive reporting to a
    // Warehouse Manager, or a cross-company manager reference). The get() on
    // the manager doc is engine-cached across the clauses, keeping the rule
    // well under the expression budget (verified live).
    //
    // CRITICAL (live-bisect, E1/E3/N2 403): Firestore rules FAIL CLOSED on
    // reading a missing map field — `data.managerId is string` does NOT return
    // false for a payload without the field, it denies the whole request. ALL
    // optional-field reads MUST gate on data.keys().hasAny([...]) first so a
    // missing field yields false (clause skipped) instead of a hard denial.
    function hasManagerId(data) {
      return data.keys().hasAny(['managerId']) && data.managerId is string && data.managerId.size() > 0;
    }

    function hasOrgField(data, field) {
      return data.keys().hasAny([field]);
    }

    // NOTE: deliberately does NOT call isSuperAdmin() (the actor chain) — an
    // actor-term here re-evaluated the identity chain and misattributed the
    // missing-field denial above to the expression budget. The manager's OWN
    // super-admin status is checked on the manager doc instead, and the actor's
    // authority is already established by the enclosing isAdmin()/sameCompany()
    // terms, so no exemption term is needed.
    function managerScopeMatches() {
      return !hasManagerId(request.resource.data)
        || (
          hasOrgField(get(/databases/$(database)/documents/users/$(request.resource.data.managerId)).data, 'isSuperAdmin')
          && get(/databases/$(database)/documents/users/$(request.resource.data.managerId)).data.isSuperAdmin == true
        )
        || (
          hasOrgField(get(/databases/$(database)/documents/users/$(request.resource.data.managerId)).data, 'isManager')
          && get(/databases/$(database)/documents/users/$(request.resource.data.managerId)).data.isManager == true
          && hasOrgField(get(/databases/$(database)/documents/users/$(request.resource.data.managerId)).data, 'department')
          && hasOrgField(get(/databases/$(database)/documents/users/$(request.resource.data.managerId)).data, 'companyId')
          && get(/databases/$(database)/documents/users/$(request.resource.data.managerId)).data.companyId == request.resource.data.companyId
          && (
            (hasOrgField(request.resource.data, 'department')
              && get(/databases/$(database)/documents/users/$(request.resource.data.managerId)).data.department == request.resource.data.department)
            || get(/databases/$(database)/documents/users/$(request.resource.data.managerId)).data.department == 'Management'
          )
        );
    }

    // An update that does NOT change the manager assignment or the department
    // skips the manager-coherence check — so editing unrelated fields (name,
    // status, phone) of a legacy user with a stale/invalid manager reference
    // remains possible instead of hard-locking user management. Any change to
    // managerId OR department re-validates the resulting state.
    function managerAssignmentUnchanged() {
      return hasOrgField(request.resource.data, 'managerId') == hasOrgField(resource.data, 'managerId')
        && (!hasOrgField(request.resource.data, 'managerId') || request.resource.data.managerId == resource.data.managerId)
        && hasOrgField(request.resource.data, 'department') == hasOrgField(resource.data, 'department')
        && (!hasOrgField(request.resource.data, 'department') || request.resource.data.department == resource.data.department);
    }

    // Phase 1 (Channel Partner identity): `users.channelPartnerId` may only be
    // ESTABLISHED once (absent → value, the controlled `linkPartnerUser` dual
    // write). Once present it is immutable — a plain client update cannot
    // re-point or clear the link. Mirrors the hasManagerId() idiom: reads of
    // an optional field MUST gate on keys().hasAny() first, or a missing
    // field becomes a hard rules denial instead of a skipped clause.
    function channelPartnerLinkUnchanged() {
      return !resource.data.keys().hasAny(['channelPartnerId'])
        || (request.resource.data.keys().hasAny(['channelPartnerId'])
            && request.resource.data.channelPartnerId == resource.data.channelPartnerId);
    }

    // Phase 1 (Channel Partner identity): canonical partner self-read — the
    // partner's own record resolves through the user-side denormalized link
    // users/{uid}.channelPartnerId == {partnerId} (set by linkPartnerUser), in
    // addition to the partner-side legacy `userId` field. get() is engine-
    // cached; this branch only evaluates for role 'Partner' actors.
    function partnerLinkedToSelf(partnerId) {
      return hasUserProfile()
        && get(/databases/$(database)/documents/users/$(currentUserId())).data.keys().hasAny(['channelPartnerId'])
        && get(/databases/$(database)/documents/users/$(currentUserId())).data.channelPartnerId == partnerId;
    }

    // Phase 1 (Channel Partner identity): partner-side mirror of
    // channelPartnerLinkUnchanged — `channel_partners.userId` is the OTHER half
    // of the controlled linkPartnerUser dual-write (users.channelPartnerId
    // <-> channel_partners.userId). Once a REAL userId is present it is
    // immutable, so a direct same-company update cannot desync the pair by
    // clearing/re-pointing the partner side. Absent OR empty-string means "not
    // linked" (matches the hasManagerId idiom; the demo seed uses '' for the
    // unlinked partner), so the FIRST controlled link is still allowed.
    function partnerUserIdUnchanged() {
      return !resource.data.keys().hasAny(['userId'])
        || resource.data.userId == ''
        || (request.resource.data.keys().hasAny(['userId'])
            && request.resource.data.userId == resource.data.userId);
    }

    // F-13 (Phase 0): the active-actor gate is applied at the TOP-LEVEL allow
    // clauses (not inside these helpers) so each request pays for actorIsActive()
    // once per matching match block instead of once per nested helper call.
    // The Firestore emulator counts every subexpression toward the
    // 1000-expression-per-request budget WITHOUT short-circuiting across the
    // matching blocks, and canReadProjectScoped()/canSeeNotification() etc.
    // re-enter these helpers and the identity chain several times per request —
    // embedding actorIsActive() here re-introduced the live-bisected
    // expression-multiplier class (F4/G2/J2/K3) and pushed legitimate reads
    // (e.g. an Admin reading a projects doc) over the budget. Top-level
    // placement is also exactly what Master Plan §9.2 prescribes.
    function canCreateCompanyScoped() {
      return signedIn() && sameCompany(request.resource.data) && groupIdMatchesCompany(request.resource.data);
    }

    function canReadCompanyScoped() {
      return signedIn() && sameCompany(resource.data);
    }

    function canUpdateCompanyScoped() {
      return signedIn() && sameCompany(resource.data) && sameCompany(request.resource.data) && companyIdUnchanged()
        && groupIdMatchesCompany(request.resource.data);
    }

    // LEAN update-tenant check for the Phase 2 sensitive-collection role
    // gates (employees/payroll/payments/banks/commission_records/
    // settlements). Mirrors warehouseActorCanUpdate()'s direct-comparison
    // shape (authMapPath().companyId == existing.companyId, ONE
    // companyGroupIsActive() call, not sameCompany()'s two) rather than
    // canUpdateCompanyScoped(), whose sameCompany()x2 + isSuperAdmin()/
    // userCompanyId() re-entry pushed these collections' UPDATE past the
    // 1000-expression cap even after switching the role gate itself to the
    // lean actor* helpers (live-verified 2026-08-26). Deliberately excludes
    // its own Owner/SuperAdmin bypass — the caller hoists that bypass to the
    // ternary-discriminator level so it is evaluated once, not once here
    // and again in the caller's role gate.
    function tenantWriteCanUpdate(existing) {
      return hasAuthMap()
        && get(authMapPath()).data.keys().hasAny(['companyId'])
        && get(authMapPath()).data.companyId is string
        && existing.companyId == get(authMapPath()).data.companyId
        && companyGroupIsActive(existing)
        && companyIdUnchanged()
        && groupIdMatchesCompany(request.resource.data);
    }

    function isPartner() {
      return hasUserProfile() && currentUser().role == 'Partner';
    }

    function isProjectScopedRole() {
      return hasUserProfile() && currentUser().role in ['Surveyor', 'Engineer', 'InstallationLead', 'ServiceTechnician', 'ComplianceOfficer'];
    }

    function canReadProjectScoped(data) {
      return sameCompany(data)
        && (
          isAdmin()
          || currentUser().role == 'Director'
          || !isProjectScopedRole()
          || data.assignedSurveyor == currentUserId()
          || data.assignedInstaller == currentUserId()
          || data.salesOwner == currentUserId()
          || data.designerId == currentUserId()
        );
    }

    // ── Phase 6 (Channel Partner — Vendor Lock / Scheme Registration) ──────
    // Team scope: a channel_partners doc's managerId is the TL/Manager's ERP
    // user id (assignPartnerManager). Manager access to a partner's records
    // requires being THAT partner's manager — never a broad Manager role
    // match — so Manager A cannot reach Manager B's agents. Identity reads
    // reuse the Phase 1 canonical helpers (partnerLinkedToSelf /
    // currentUserId); every get() is engine-cached and each clause
    // short-circuits, keeping the rules well under the expression budget.
    function schemeRegManagerOfPartner(partnerId) {
      return partnerId is string && partnerId.size() > 0
        && exists(/databases/$(database)/documents/channel_partners/$(partnerId))
        && hasOrgField(get(/databases/$(database)/documents/channel_partners/$(partnerId)).data, 'managerId')
        && get(/databases/$(database)/documents/channel_partners/$(partnerId)).data.managerId == currentUserId();
    }

    // Read scope (spec §19): partner self via users.channelPartnerId, TL/
    // Manager team via channel_partners.managerId, Director (view-only
    // executive visibility), Admin. Cross-company denied by sameCompany();
    // Accounts gets nothing.
    function schemeRegCanRead(data) {
      return sameCompany(data)
        && (
          isAdmin()
          || roleMatches('Director')
          || (isSchemeRegManagerRole() && schemeRegManagerOfPartner(data.partnerId))
          || (isPartner() && partnerLinkedToSelf(data.partnerId))
        );
    }

    // Partner create (§9.3): the partnerId being written must be the
    // authenticated partner's OWN id AND must equal the referenced project's
    // partnerId — a partner can never stamp a foreign partnerId or attach
    // another partner's project.
    function schemeRegPartnerOwnsProject(data) {
      return isPartner()
        && partnerLinkedToSelf(data.partnerId)
        && data.projectId is string && data.projectId.size() > 0
        && exists(/databases/$(database)/documents/projects/$(data.projectId))
        && hasOrgField(get(/databases/$(database)/documents/projects/$(data.projectId)).data, 'partnerId')
        && get(/databases/$(database)/documents/projects/$(data.projectId)).data.partnerId == data.partnerId;
    }

    // Manager create: the project's owning partner must report to the acting
    // Manager (team scope — never a foreign partner's project).
    function schemeRegManagerOwnsProject(data) {
      return isSchemeRegManagerRole()
        && data.projectId is string && data.projectId.size() > 0
        && exists(/databases/$(database)/documents/projects/$(data.projectId))
        && hasOrgField(get(/databases/$(database)/documents/projects/$(data.projectId)).data, 'partnerId')
        && schemeRegManagerOfPartner(get(/databases/$(database)/documents/projects/$(data.projectId)).data.partnerId);
    }

    // Identity immutability on update: a registration can never be re-pointed
    // at a different project, partner or company — ownership comes from the
    // canonical chain, never a late edit.
    function schemeRegIdentityUnchanged() {
      return request.resource.data.partnerId == resource.data.partnerId
        && request.resource.data.projectId == resource.data.projectId
        && request.resource.data.companyId == resource.data.companyId;
    }

    // F-02 (Phase 0): isSpecialCollection() now also covers the 14 collections
    // that previously fell through to the generic wildcard below — under
    // Firestore's OR-across-matching-match-blocks semantics, the wildcard's
    // weaker company-only grant silently nullified these collections' own
    // stricter, purpose-built rules (project-assignment read scoping,
    // purchase-order status machine, projectId identity immutability), which
    // the audit EMPIRICALLY confirmed bypassable on the write path
    // (unassigned Surveyor: illegal Draft->Received transition and illegal
    // projectId mutation, 3/3 reproductions). Excluding them makes the specific
    // blocks authoritative. Also adds security_logs (F-04), device_tokens
    // (F-17) and backup_metadata (F-05), which now have their own blocks.
    function isSpecialCollection(collectionId) {
      // Security Remediation Phase 2 (F-06/RULES-001): employees, payroll,
      // payments, banks, commission_records, settlements added — each now
      // has its own role-aware match block below and must be excluded from
      // the role-blind generic fallback.
      // Face Attendance + DeepFace Master Plan, Phase 3: 'biometric_face_references'
      // added — it has its own role-aware match block above (self/Admin-HR/
      // GroupAdmin, not the role-blind company-scoped fallback) and MUST be
      // excluded here, or the generic fallback below would additively grant
      // ANY same-company active user read/write access via
      // canReadCompanyScoped()/canCreateCompanyScoped()/canUpdateCompanyScoped()
      // (Firestore evaluates every matching `match` block for a path and
      // allows the request if ANY grants it — a dedicated block alone does
      // NOT suppress the generic fallback from ALSO applying).
      return collectionId in ['users', 'user_auth_maps', 'companies', 'roles', 'settings', 'audit_logs', 'dispatch', 'stock', 'stock_ledger', 'notifications', 'tasks', 'error_logs', 'customer_phone_locks', 'channel_partners', 'partner_wallet_transactions', 'commission_rules', 'tax_invoices', 'goods_receipts', 'document_counters', 'demo_operations', 'scheme_registrations', 'projects', 'surveys', 'engineering_designs', 'purchase_orders', 'installations', 'product_categories', 'service_tickets', 'qc_checks', 'commissioning_records', 'net_metering_applications', 'subsidy_applications', 'project_handovers', 'amc_contracts', 'generation_readings', 'security_logs', 'device_tokens', 'backup_metadata', 'groups', 'group_members', 'warehouses', 'platform_settings', 'attendance', 'employees', 'payroll', 'payments', 'banks', 'commission_records', 'settlements', 'biometric_face_references'];
    }

    match /companies/{companyId} {
      // Settings -> Companies root-cause fix: the app deliberately treats
      // `companies` as a GLOBAL, unscoped collection (see companyScopedQuery()
      // and OWNERSHIP_EXEMPT_COLLECTIONS in lib/firestore.ts — both return/list
      // it with NO companyId filter, by design, so an Admin can manage every
      // legal-entity/branch company record, not just one). getAll() therefore
      // issues a collection-wide query with no `where` clause at all.
      // Firestore can only allow a listed/queried read when the rule is
      // PROVABLY true for any possible matched document from the query's own
      // shape — the old fallback branch below compares against the requested
      // document's OWN id (== userCompanyId()), which a query with no id/path
      // constraint can never satisfy for anyone but isOwnerIdentity()/
      // isSuperAdmin() (the only branches that don't depend on the matched
      // document at all). Every non-owner Admin got PERMISSION_DENIED on the
      // whole list, not just their own record — the "Failed to load data"
      // root cause. isAdmin()/Director are added as the same kind of
      // document-independent, statically-provable predicate, matching the
      // trust level the create/update rules below already grant isAdmin()
      // for full company management. roleBootstrap.ts's Director role is
      // explicitly documented as read-only executive visibility across core
      // modules including `companies: { view: true }`.
      // F-01 (Phase 0): read is now company-scoped — the actor may read only
      // the companies record(s) of their OWN company (field-anchored on
      // resource.data.companyId so list queries with where('companyId','==',...)
      // stay provable), plus owner/Super Admin platform-wide. The previous
      // unconditional isAdmin()/Director grant let any Admin of any company read
      // every tenant's record (legal name, GST/PAN/CIN, bank details) — the
      // cross-tenant disclosure the audit rated CRITICAL. The matching client
      // query scoping lives in src/lib/firestore.ts (companyScopedQuery).
      // Phase 2 (§9.3 additive-OR): a Group Admin may read the companies of
      // their own Group (companies docs carry groupId per §3.2), list them
      // (where('groupId','==',actorGroupId) is provable against
      // groupAdminCanRead), and — Admin-equivalent per §5.2 — create a company
      // in their own Group (the request's groupId must equal the actor's
      // authoritative group: a forged Group B groupId is rejected).
      allow read: if actorIsActive() && (isOwnerIdentity()
        || isSuperAdmin()
        || (hasUserProfile() && (resource == null || (hasCompanyId(resource.data) && resource.data.companyId == userCompanyId())))
        || groupAdminCanRead(resource.data));
      // §5.2: GroupAdmin grants == the target Company's Admin grants — so the
      // GroupAdmin create branch mirrors the Admin branch's id-anchor and
      // requires the new company's groupId == actorGroupId() (never a
      // client-chosen Group) and the Group to be Active.
      allow create: if actorIsActive() && (isAdmin() && hasCompanyId(request.resource.data) && request.resource.data.id == companyId && sameCompany(request.resource.data))
        || (isGroupAdmin() && hasCompanyId(request.resource.data) && request.resource.data.id == companyId
          && hasGroupId(request.resource.data) && request.resource.data.groupId == actorGroupId()
          && groupIsActive(request.resource.data.groupId));
      // Round-robin assignment exception (RBAC create-permission root cause,
      // part 2, found via live browser verification): creating a Lead with
      // no explicit assignee triggers getNextAssignee()'s round-robin logic,
      // which persists its rotation pointer via a single-field update to the
      // company doc (roundRobinPointer) — an internal operational counter
      // with no security/branding/business-config meaning. Requiring
      // isAdmin() for this ONE field meant no non-admin role could ever
      // create an unassigned lead (or any flow relying on auto-assignment),
      // even with leads:create granted. The exception is scoped tightly: it
      // permits touching ONLY roundRobinPointer (plus the standard
      // updatedBy/updatedAt audit fields every write already carries) —
      // company name, branding, business mode, and everything else remain
      // admin-only, exactly as before.
      allow update: if actorIsActive() && (
        (isAdmin() && sameCompany(resource.data) && sameCompany(request.resource.data) && companyIdUnchanged()
          && resource.data.id == companyId && request.resource.data.id == companyId)
        || (isGroupAdmin() && hasGroupId(resource.data) && hasGroupId(request.resource.data)
          && resource.data.groupId == actorGroupId() && request.resource.data.groupId == actorGroupId()
          && groupIdUnchanged() && companyIdUnchanged() && groupIsActive(resource.data.groupId)
          && resource.data.id == companyId && request.resource.data.id == companyId)
        || (signedIn() && hasUserProfile() && companyId == userCompanyId()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['roundRobinPointer', 'updatedBy', 'updatedAt'])));
      allow delete: if false;
    }

    // A role is a system role only when it EXPLICITLY carries isSystem==true.
    // roles docs created before the data-driven model may lack the field — and
    // Firestore rules FAIL CLOSED on reading a missing map field (the same
    // live-bisected class as hasManagerId), so the check MUST gate field access
    // on keys().hasAny(['isSystem']) first. A missing/absent field means the
    // role is custom/manageable by company Admins.
    function roleNotSystemProtected(data) {
      return !data.keys().hasAny(['isSystem']) || data.isSystem != true;
    }

    // AD-1 (2026-08-22) blocked EVERY update to a system role document for
    // every non-Super-Admin actor (roleNotSystemProtected(oldData) &&
    // roleNotSystemProtected(newData) on the whole write) — reproduced live
    // against production as the real, reported failure: a Group Admin (and,
    // by the same rule, an ordinary Company Admin) could never save a single
    // permission-matrix change on a seeded system role (Admin, Director,
    // Sales, Operations, ...), even though the Roles.tsx UI leaves every
    // permission checkbox fully interactive for them (only the Name field is
    // UI-disabled, and Delete is UI-hidden, for system roles) — an "action
    // button visible but backend rejects" gap, not a working design.
    // AD-1's own governing text is scoped to "cannot create/promote system
    // roles" — this narrows enforcement to match that scope exactly: a
    // system role's PERMISSION GRANTS, description, department and manager
    // flag remain fully editable by Admin/GroupAdmin (their whole reason to
    // exist), while its identity — name and the isSystem flag itself — stays
    // immutable for anyone but Super Admin/Owner (who keep the unrestricted
    // `|| isSuperAdmin()` bypass on the Admin branch, unchanged). Creating a
    // NEW role with isSystem==true, or promoting an existing custom role to
    // isSystem==true, remains Super-Admin-only via the unmodified `create`
    // rule and roleNotSystemProtected(request.resource.data) above.
    function roleSystemIdentityUnchanged(oldData, newData) {
      return (roleNotSystemProtected(oldData) && roleNotSystemProtected(newData))
        || (!roleNotSystemProtected(oldData) && !roleNotSystemProtected(newData)
          && newData.name == oldData.name);
    }

    // ── Phase 3 (F-07/F-08) — warehouses collection ────────────────────────
    // Previously the ONLY collection with warehouse-scoped meaning that had no
    // explicit rules block at all (audit §9: "relies entirely on the generic
    // wildcard"). This explicit block makes the FK target deliberate, matching
    // the company-scoped read/create/update the generic fallback already
    // granted, plus (a) companyId immutability on update, (b) delete denied
    // everywhere (soft-delete via status is the only path), and (c) the
    // §5.2 GroupAdmin additive-OR. §8.1 deliberately does NOT warehouse-scope
    // the warehouses collection itself (sameWarehouse applies to stock /
    // dispatch / goods_receipts — "the three collections where warehouse-
    // level data actually differs meaningfully"); warehouse metadata stays
    // company-readable so every role can list warehouses for selection.
    match /warehouses/{warehouseId} {
      allow read: if actorIsActive() && (canReadCompanyScoped() || groupAdminCanRead(resource.data));
      // A warehouse doc's companyId FK: the warehouse must be created into the
      // actor's own company (sameCompany anchors it) — no cross-company
      // warehouses. GroupAdmin additive-OR keeps §5.2 Admin-equivalence.
      allow create: if actorIsActive() && (canCreateCompanyScoped() || groupAdminCanCreate(request.resource.data))
        && request.resource.data.id == warehouseId
        && hasCompanyId(request.resource.data);
      allow update: if actorIsActive() && (canUpdateCompanyScoped() || groupAdminCanUpdate(resource.data))
        && companyIdUnchanged();
      allow delete: if false;
    }

    match /roles/{roleId} {
      // F-03 closure (Phase 1, Master Plan §5.6): roles read is now Company-
      // scoped — role documents are per-company keyed (`${companyId}_${roleName}`
      // for system templates, ROL-* for custom roles) and carry the owning
      // companyId, so the permission bootstrap resolves the actor's role against
      // THEIR company's role documents. sameCompany() keeps the owner/Super
      // Admin platform-wide read. The `resource == null` guard mirrors the users
      // block: a get() on a not-yet-created doc (existence probes) must return a
      // clean "not found" instead of an evaluation error denied as 403. Phase 0
      // left this read open because the then-current name-keyed SHARED templates
      // could not be company-scoped without locking out non-stamping companies;
      // the Phase 1 backfill (scripts/backfill-group-denorm.cjs) creates the
      // per-company keyed copies BEFORE this rule ships (expand → backfill →
      // contract ordering, Master Plan §10.3).
      allow read: if actorIsActive() && signedIn() && (resource == null || canReadCompanyScoped() || groupAdminCanReadRole(resource.data));
      // Phase 1 (RBAC-F01/RBAC-F16 closure, 2026-08-22): two problems fixed in
      // the same change because both live in this one authorization boundary.
      //
      // RBAC-F01 — GroupAdmin had NO write path at all: isAdmin() only matches
      // the literal role 'Admin', so a GroupAdmin (whose grants are otherwise
      // resolved as "the target Company's own Admin permissions", exactly like
      // every other module) was denied unconditionally. Fixed by reusing
      // groupAdminCanReadRole() — already proven, already tested on the read
      // rule above, and structurally the correct helper: role docs carry only
      // companyId (never groupId, §3.2), so the GENERIC groupAdminCanCreate()/
      // groupAdminCanUpdate() (which require hasGroupId(data)) can never match
      // a role document — groupAdminCanReadRole()'s companies/{companyId}.
      // groupId == actorGroupId() resolution is the only correct shape for
      // this collection, same reason it was needed for the read rule. Reusing
      // it here (rather than writing a second, near-duplicate helper) also
      // keeps this change's expression cost to exactly one more call site per
      // clause, not a new heavy helper — sizing this deliberately against the
      // 1000-expression budget after this session's earlier Stock/Attendance
      // overflows from "obviously correct" full helpers.
      //
      // RBAC-F16 — isAdmin() alone carries NO company-scoping (no sameCompany,
      // no companyIdUnchanged), unlike every sibling collection in this file
      // (see the `companies` block's own update rule above). As deployed
      // before this change, any Company Admin could create or update ANY
      // OTHER company's role document, including relocating it or silently
      // editing another company's permission grants. Fixed by adding
      // sameCompany()/companyIdUnchanged() to the Admin branch, mirroring the
      // `companies` collection's own established pattern exactly (that
      // pattern already subjects isAdmin()'s SuperAdmin/owner bypass to the
      // same companyIdUnchanged() guard too — this is this file's own
      // existing convention for "unrestricted WHICH company, but not free
      // relocation", not a new restriction invented for this change).
      //
      // System-role protection (roleNotSystemProtected) is preserved
      // unchanged for Admin and applied identically to GroupAdmin (AD-1,
      // approved 2026-08-22): GroupAdmin may manage custom roles in-scope,
      // never system roles — the same boundary an ordinary Admin already has.
      //
      // groupId-ban: role documents never carry a groupId field, for anyone,
      // by design (§3.2 excludes `roles` from the groupId denormalization).
      // A write that ever introduces a groupId key is rejected outright — the
      // most direct way to make "GroupAdmin cannot forge/move via groupId"
      // true, and it restricts nothing SuperAdmin legitimately does today
      // (roleBootstrap.ts's seeds never write groupId either).
      allow create: if actorIsActive() && (
        (isAdmin() && sameCompany(request.resource.data) && (roleNotSystemProtected(request.resource.data) || isSuperAdmin()))
        || (groupAdminCanReadRole(request.resource.data) && roleNotSystemProtected(request.resource.data))
      ) && !request.resource.data.keys().hasAny(['groupId']);
      // Expression-budget note (live-verified 2026-08-22, same class as this
      // session's earlier Stock/Attendance overflows): the "obviously
      // correct" first draft here — sameCompany() called on BOTH resource.data
      // and request.resource.data, plus `|| isSuperAdmin()` repeated on both
      // system-role guards — exceeded the 1000-expression budget specifically
      // on a Super Admin system-role update (every heavy identity/company
      // helper compounding with the wildcard fallback's own fixed re-
      // evaluation tax). Both simplifications below are safe, semantics-
      // preserving algebra, not a security reduction: (1) sameCompany(
      // request.resource.data) is redundant once sameCompany(resource.data)
      // and companyIdUnchanged() both hold — the two companyId values are
      // then provably identical, so the second full re-derivation (with its
      // own get()) is dropped; (2) `(A||C) && (B||C)` is algebraically
      // `(A&&B)||C` — the two separate `|| isSuperAdmin()` fallbacks collapse
      // into one, cutting a duplicated isSuperAdmin()/currentUser() re-entry.
      allow update: if actorIsActive() && (
        (isAdmin() && sameCompany(resource.data) && companyIdUnchanged()
          && (roleSystemIdentityUnchanged(resource.data, request.resource.data) || isSuperAdmin()))
        || (groupAdminCanReadRole(resource.data) && companyIdUnchanged()
          && roleSystemIdentityUnchanged(resource.data, request.resource.data))
      ) && !request.resource.data.keys().hasAny(['groupId']);
      // DELETE: out of Phase 1 scope — RBAC-F01/RBAC-F16 are create/update-only
      // findings. allow delete: if false is preserved unchanged for every
      // actor, including Super Admin (soft-delete, via deleteDocById ->
      // softDelete() -> updateDocById, is already correctly covered by the
      // update fix above as a natural consequence, not a separate grant).
      allow delete: if false;
    }

    match /users/{userId} {
      // A signed-in user with no mapping may only query/read the profile whose
      // email exactly matches the verified Firebase Authentication email.
      // resource == null must be checked first: a get() on a not-yet-created
      // users/{id} doc (e.g. createOrResolveUserByPhone's existence probe
      // during Admin "Add User") otherwise dereferences resource.data on a
      // null resource, which Firestore's rule engine treats as an evaluation
      // error and denies with PERMISSION_DENIED instead of a clean "not
      // found" — indistinguishable from a real 403 client-side, and fatal to
      // the create-user flow (Admin create-user runtime-failure root cause,
      // found via live browser verification). Mirrors the same guard already
      // used by the settings collection's get rule for the identical reason.
      // F-13 (Phase 0): a deactivated user must still be able to read their OWN
      // document (email-self branch — the deliberate exception per Master Plan
      // §9.2, so the app can render a clear "your account is inactive" message
      // instead of a raw permission-denied). Every OTHER access path requires
      // an active actor (actorIsActive()).
      // §9.3 (Phase 2): a Group Admin may read the users of every Company in
      // their own Group (users docs carry the §3.2 denormalized groupId);
      // anything outside the Group fails closed. All pre-existing paths
      // (email self-read, same-company, owner/Super Admin) are unchanged.
      // get/list split (mirrors the settings block): the GET rule keeps the
      // F-13 deliberate exception (a deactivated user can still read their OWN
      // document) and the email-self branch, guarded by keys().hasAny() so the
      // LIST provability engine (which evaluates against shadow docs without
      // every field) never hits a missing-field evaluation error.
      allow get: if signedIn()
        && (resource == null
          || (resource.data.keys().hasAny(['email']) && request.auth.token.email == resource.data.email)
          || actorIsActive() && (isOwnerIdentity() || (hasUserProfile() && sameCompany(resource.data)) || isSuperAdmin() || groupAdminCanRead(resource.data)));
      // The LIST rule is deliberately leaner (no email-self / null-resource
      // branches — those are get-only semantics): every list path requires an
      // active actor, and the provable branches are the same-company /
      // same-Group / platform ones. The same-company branch uses the direct
      // companyId comparison + the §9.6 Group-active gate instead of the full
      // sameCompany() chain (whose re-entered identity reads are what pushes
      // list provability over the 1000-expression budget — the same
      // multiplier class live-bisected as F4/G2/J2/K3).
      allow list: if signedIn() && actorIsActive()
        && (isOwnerIdentity() || isSuperAdmin()
          || (hasUserProfile() && hasCompanyId(resource.data)
            && resource.data.companyId == userCompanyId()
            && companyGroupIsActive(resource.data))
          || groupAdminCanRead(resource.data));
      // Contact-identity exception (RBAC create-permission root cause, found
      // via live browser verification): creating a Lead/Customer/Employee
      // (any role with the corresponding module's `create` permission, not
      // just Admin) internally writes a phone-keyed master-identity contact
      // record here via createOrResolveUserByPhone/resolveOrCreateMasterUser
      // — this is NOT a real ERP staff account, it carries one of the fixed
      // non-staff role markers below (never a real RBAC role name, and never
      // for the Admin "Add User" flow, whose payload always carries the
      // actual selected RBAC role instead of falling back to this marker).
      // Without this exception EVERY non-Admin role was silently unable to
      // create a lead/customer/employee whose phone number didn't already
      // have an identity record — the normal case for a brand-new lead —
      // even with the module's `create` permission explicitly granted.
      // isSuperAdmin/manager/owner-email guards below still apply unchanged.
      function isContactIdentityRole(data) {
        return data.role in ['Lead', 'Customer', 'Employee', 'Driver', 'Vendor', 'InstallationPartner', 'FieldAgent'];
      }
      // Root cause (live-verified, 2026-08-19): a Group Admin creating a
      // staff user was denied with a raw PERMISSION_DENIED that turned out
      // to be the Firestore rules engine's 1000-expression-per-request
      // budget being exceeded, not an actual authorization mismatch —
      // confirmed by reproducing the identical failure against the emulator
      // with the REAL, unmodified rules and production-shaped data ("Unable
      // to evaluate the expression as the maximum of 1000 expressions...").
      // Root-caused further: `||` between the two branches below did NOT
      // reliably short-circuit the (isAdmin()||contact-identity) branch once
      // it resolved false — Firestore still walked its sameCompany() /
      // groupAdminCanCreate() / groupIdMatchesCompany() sub-terms, each of
      // which get()s the companies/{companyId} document (which carries
      // several embedded base64 logo/QR/signature images — a large document,
      // and this rules engine's per-request expression budget appears to
      // scale with fetched-document size, not just call count). A GroupAdmin
      // actor paid for BOTH branches' full cost on every attempt.
      //
      // Fix: a ternary (`cond ? A : B`), unlike `||`, is a GUARANTEED lazy
      // construct in this rules language (already relied on elsewhere in
      // this file, e.g. actorGroupId()'s own ternary) — exactly one arm is
      // ever evaluated. isGroupAdmin() is a cheap, already-necessary
      // discriminator: a user's role is never simultaneously 'Admin' and
      // 'GroupAdmin', so routing GroupAdmin actors to the dedicated arm below
      // and every other actor to the original (unchanged) branch changes
      // nothing about who is authorized — it only stops a GroupAdmin actor
      // from ever touching the Admin/contact-identity branch's cost.
      //
      // The GroupAdmin arm below is a strict superset of what that actor
      // could previously reach via EITHER path: the original GroupAdmin
      // branch (§4.4, staff creation — unchanged conditions), AND the
      // original branch 1's GroupAdmin-reachable fallback
      // (isContactIdentityRole() && groupAdminCanCreate(), for Lead/Customer/
      // Employee/... contact records) — groupAdminCanCreate() required
      // EXACTLY the same group/company coherence this arm already requires
      // (hasGroupId + groupId==actorGroupId() + groupIsActive +
      // groupIdMatchesCompany), so nothing a GroupAdmin could legitimately
      // create before (staff OR contact identities, in any Company of their
      // own Group) is newly denied — role is only restricted from
      // 'GroupAdmin'/isSuperAdmin:true, exactly as before. The Admin/
      // contact-identity branch (§ below) is untouched for every non-
      // GroupAdmin actor (Admin staff creation, or any signed-in user's own-
      // company contact-identity creation).
      allow create: if actorIsActive() && request.resource.data.email != 'shreeniwas.tripathi0@gmail.com'
        && (isGroupAdmin()
          ? (
            hasCompanyId(request.resource.data)
            && hasGroupId(request.resource.data) && request.resource.data.groupId == actorGroupId()
            && groupIsActive(request.resource.data.groupId)
            && exists(/databases/$(database)/documents/companies/$(request.resource.data.companyId))
            && get(/databases/$(database)/documents/companies/$(request.resource.data.companyId)).data.groupId == request.resource.data.groupId
            && (!request.resource.data.keys().hasAny(['role']) || request.resource.data.role != 'GroupAdmin')
            && (!request.resource.data.keys().hasAny(['isSuperAdmin']) || request.resource.data.isSuperAdmin != true)
          )
          : (
            // Existing company path (unchanged): Admin staff creation or any
            // signed-in user creating a phone-keyed contact identity
            // (Lead/Customer/Employee/...).
            (isAdmin() || (signedIn() && isContactIdentityRole(request.resource.data)))
            && hasCompanyId(request.resource.data)
            && sameCompany(request.resource.data)
            // §5.1: only Super Admin creates Group Admins.
            && (isSuperAdmin() || !request.resource.data.keys().hasAny(['role']) || request.resource.data.role != 'GroupAdmin')
            // Existence-guarded: dereferencing a field absent from the
            // document is a rules evaluation ERROR in Firestore (denied,
            // indistinguishable from a real 403), not a graceful
            // `undefined`/false. Lead/Customer/Employee creation payloads
            // never carry an isSuperAdmin field at all (only the Admin "Add
            // User" form does) — this second, independent gap meant even an
            // Admin's own lead creation would have been denied by this exact
            // line once the isAdmin()-only restriction above was relaxed.
            // Mirrors the existing hasManagerId()/hasOrgField() idiom already
            // used elsewhere in this file for the same reason.
            && (!request.resource.data.keys().hasAny(['isSuperAdmin']) || request.resource.data.isSuperAdmin != true || isSuperAdmin())
            // §3.2: a same-company-created user's groupId (when present) must
            // match their Company's Group — a forged groupId can never plant
            // a user into another Group's reach.
            && groupIdMatchesCompany(request.resource.data)
          )
        )
        && managerScopeMatches();
      // FLATTENED update rule. Live-bisect evidence: the previous deep helper
      // nesting (isSelf -> hasValidAuthMap -> currentUserId -> currentUser x3,
      // plus userCompanyId x2) exceeded the 1000-expression evaluation budget
      // and denied legitimate admin role/status updates with a silent 403.
      // This form inlines the mapping-anchored paths directly (each get() is
      // cached by the engine), short-circuits the self-update branch first,
      // and re-uses the SAME mapping read for tenant + identity anchoring, so
      // the whole rule stays far under budget.
      //
      // Owner statement is SEPARATE and FIRST: the owner literal must never
      // depend on a user_auth_maps doc existing (the mapping is lazy-created
      // at first login and could be missing/purged), so the owner bypasses
      // the anchor entirely. companyId stays immutable and the owner's own
      // record stays protected (same global clauses as the non-owner rule).
      // Budget engineering (live-bisect, 2026-08-23): branches A/B/C below
      // used to re-derive get(authMapPath()).data.userId and
      // get(users/{mappedUserId}).data ~13 times across separate literal
      // call sites. Each get() itself is engine-cached (same resolved path),
      // but every repeated .data.field chain is still its own AST node
      // counted toward the 1000-expression request budget. A real save from
      // the Users workspace always recomputes `department` (+ `isManager`)
      // alongside `role` (useUsers.ts's enrichOrgFields — every edit, not
      // just role changes), which flips managerAssignmentUnchanged() to
      // false and forces managerScopeMatches() to actually evaluate — a
      // payload shape the pre-existing tests never exercised (they only
      // ever wrote a bare { role: '...' }). That one extra evaluation was
      // enough to exhaust a budget branches A/B/C had already nearly used
      // up, live-reproduced as "Missing or insufficient permissions" for a
      // Group Admin changing a user's role whenever the role change also
      // changes department (i.e. almost always) — see
      // groupAdminFullGroupAccess.emulator.test.ts. Consolidating the
      // repeated get() chains into two `let` bindings, referenced afterward
      // as cheap field lookups, cuts the evaluated-node count without
      // changing any condition's logic.
      // ROOT CAUSE (same class as isSuperAdmin() above, reproduced live
      // against the real GroupAdmin account's own missing-field users doc):
      // actor.isSuperAdmin == true and (request.resource.data.isSuperAdmin
      // == true) == (resource.data.isSuperAdmin == true) below both read the
      // field unguarded — a legacy/migrated user document (actor's own, or
      // the target being edited) missing the field entirely denies the whole
      // rule instead of treating absence as false. Guarded the same way
      // every other optional field in this file is.
      function isSuperAdminFlag(data) {
        return data.get('isSuperAdmin', false) == true;
      }
      function usersUpdateAllowed(userId) {
        let authMap = get(authMapPath()).data;
        let actor = get(/databases/$(database)/documents/users/$(authMap.userId)).data;
        return (
          // A) self-update: own profile fields only (companyId immutable).
          (authMap.userId == userId && selfAccessFieldsUnchanged()
            && request.resource.data.companyId == resource.data.companyId)
          // B) admin/super-admin: actor doc role must be Admin; super-admin
          //    may grant/revoke isSuperAdmin cross-company, company admin
          //    may manage same-company users without changing isSuperAdmin
          //    or companyId (companyId immutable on this path).
          //    Guards inlined at each site, NOT hoisted to a top-level `let`
          //    and NOT a wrapper-function call: this function is documented
          //    as already budget-marginal (see the comment block above), and
          //    a `let` at the top of the function is evaluated for EVERY
          //    call regardless of which branch (A/B/C) ultimately matches —
          //    live-verified this session to be enough, on its own, to push
          //    a branch-C-only (GroupAdmin) payload over the 1000-expression
          //    budget even though branch C never needed the actor-super
          //    check at all. Inlining keeps each guard lazy — evaluated only
          //    when the branch that actually needs it is reached — while
          //    still fixing the real bug (a missing isSuperAdmin field reads
          //    as false here, never errors, unlike the original unguarded
          //    `actor.isSuperAdmin == true`). Uses isSuperAdminFlag() (now
          //    map.get(key,default)-based — one expression, not
          //    keys().hasAny()+field-access) so each site stays cheap even
          //    called individually rather than hoisted.
          || (
            actor.role == 'Admin'
            && (
              isSuperAdminFlag(actor)
              || (
                authMap.companyId == resource.data.companyId
                && authMap.companyId == request.resource.data.companyId
                && isSuperAdminFlag(request.resource.data) == isSuperAdminFlag(resource.data)
              )
            )
            && request.resource.data.companyId == resource.data.companyId
            // §5.1: only Super Admin creates Group Admins — folded into the
            // Admin branch (the GroupAdmin branch and the self branch
            // already forbid the role), so GroupAdmin actors short-circuit
            // before it.
            && (isSuperAdminFlag(actor)
              || !request.resource.data.keys().hasAny(['role'])
              || request.resource.data.role != 'GroupAdmin')
          )
          // C) §4.4 (Phase 2): Group Admin manages any user inside their own
          //    Group — including same-Group Company transfer (users.companyId
          //    may change; this is the ONE deliberate companyId-immutability
          //    relaxation in the whole plan). Never a Group escape: the
          //    target user's groupId must equal the actor's authoritative
          //    Group and stay unchanged. Never a promotion: the isSuperAdmin
          //    flag cannot change and the role can only be changed to a
          //    non-GroupAdmin value (only Super Admin creates Group Admins —
          //    §5.1). The NEW companyId must belong to the actor's Group.
          //    Phase 5 (§7.9): ONE deliberate promotion exception — an
          //    active Group Admin may add a SECOND Group Admin for their own
          //    Group. The target must (a) not be the actor (self-promotion
          //    remains forbidden), and (b) already have its authoritative
          //    group_members/{groupId}_{userId} record.
          || (
            actor.role == 'GroupAdmin'
            && hasGroupId(resource.data) && resource.data.groupId == actorGroupId()
            && groupIsActive(resource.data.groupId)
            && isSuperAdminFlag(request.resource.data) == isSuperAdminFlag(resource.data)
            && (
              !request.resource.data.keys().hasAny(['role'])
              || request.resource.data.role != 'GroupAdmin'
              // §7.9 promotion exception — reached only when role IS
              // 'GroupAdmin' (the clause above failed). The self-grant case
              // (target == actor) is the one promotion shape that must
              // ALWAYS be denied.
              || (userId != authMap.userId
                && exists(/databases/$(database)/documents/group_members/$(resource.data.groupId + '_' + userId)))
            )
            && groupAdminUserCompanyMatches(request.resource.data)
          )
        )
        // §3.2: users.groupId is immutable on update for every actor class
        // (GroupAdmin's group is set at creation; every other user's groupId
        // is derived from their companyId's Group, and same-Group Company
        // transfers keep the groupId unchanged).
        && groupIdUnchanged()
        // Phase 1: channelPartnerId immutable once established.
        && channelPartnerLinkUnchanged()
        // Manager-department coherence (data-driven section model). Skipped
        // when the assignment is unchanged (legacy-edit escape hatch);
        // enforced whenever managerId/department actually change.
        && (managerAssignmentUnchanged() || managerScopeMatches())
        // Owner-record protection (existing doc email).
        && resource.data.email != 'shreeniwas.tripathi0@gmail.com';
      }

      allow update: if actorIsActive() && isOwnerIdentity()
        // companyId immutable on update
        && request.resource.data.companyId == resource.data.companyId
        // Phase 1: channelPartnerId immutable once established.
        && channelPartnerLinkUnchanged()
        // Owner-record protection (existing doc email).
        && resource.data.email != 'shreeniwas.tripathi0@gmail.com';
      // Non-owner update rule — flattened, mapping-anchored, budget-
      // engineered (see usersUpdateAllowed() above for why and how).
      // Anchor: the actor must have a self-owned auth map whose userId points
      // at their ERP identity doc (master-identity MUSR-* ids are valid) and
      // whose email == verified token email. Branches A/B/C and the shared
      // tail conditions live in usersUpdateAllowed(userId), called only once
      // this anchor has already passed.
      allow update: if actorIsActive() && signedIn()
        && exists(/databases/$(database)/documents/user_auth_maps/$(request.auth.uid))
        && get(/databases/$(database)/documents/user_auth_maps/$(request.auth.uid)).data.userId is string
        && get(/databases/$(database)/documents/user_auth_maps/$(request.auth.uid)).data.email == request.auth.token.email
        && usersUpdateAllowed(userId);
      // Contact-identity role-attach (the UPDATE half of the isContactIdentityRole
      // create exception above). The internal Lead/Customer/Employee create flow
      // (lib/entityProjection.ts attachUserId -> lib/userIdentity.ts
      // createOrResolveUserByPhone -> attachUserRole) first CREATEs a phone-keyed
      // master-identity users doc (allowed by the contact-identity `create`
      // branch), then immediately UPDATEs it to merge the projection's role into
      // roles[]/linkedModules[]. Without a matching update branch that second
      // write was denied for every non-Admin / non-GroupAdmin actor (Sales,
      // Manager, ...), leaving an orphan users/MUSR-* doc and surfacing a raw
      // "Missing or insufficient permissions" while the Lead itself was never
      // written — a non-atomic partial failure (emulator-reproduced,
      // leadCreationProjectionWrites.emulator.test.ts). Scoped exactly to that
      // flow and no wider than the create exception:
      //   - the EXISTING doc must already be a contact identity (never a staff
      //     account — role/isSuperAdmin/status cannot be changed here)
      //   - the actor is any active, same-company signed-in user, anchored on
      //     their self-owned auth map (email == verified token email) whose
      //     companyId equals the target doc's companyId (no cross-tenant reach)
      //   - only the projection-owned fields may change (companyId / role /
      //     groupId / isSuperAdmin / status / channelPartnerId are all immutable)
      allow update: if actorIsActive() && signedIn()
        && isContactIdentityRole(resource.data)
        && isContactIdentityRole(request.resource.data)
        && request.resource.data.role == resource.data.role
        && request.resource.data.companyId == resource.data.companyId
        && groupIdUnchanged()
        && channelPartnerLinkUnchanged()
        && request.resource.data.get('isSuperAdmin', false) == resource.data.get('isSuperAdmin', false)
        && request.resource.data.get('status', '') == resource.data.get('status', '')
        && resource.data.email != 'shreeniwas.tripathi0@gmail.com'
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['roles', 'linkedModules', 'entityId', 'userId', 'masterUserId', 'name', 'email', 'phone', 'updatedAt', 'updatedBy'])
        && exists(/databases/$(database)/documents/user_auth_maps/$(request.auth.uid))
        && get(/databases/$(database)/documents/user_auth_maps/$(request.auth.uid)).data.email == request.auth.token.email
        && get(/databases/$(database)/documents/user_auth_maps/$(request.auth.uid)).data.companyId == resource.data.companyId;
      allow delete: if false;
    }

    match /user_auth_maps/{authUid} {
      function validOwnMapping(data) {
        return signedIn()
          && authUid == request.auth.uid
          && data.keys().hasOnly(['authUid', 'userId', 'companyId', 'email', 'groupId', 'createdAt', 'updatedAt'])
          && data.authUid == request.auth.uid
          && data.userId is string
          && data.companyId is string
          && data.email is string
          && request.auth.token.email is string
          && data.email == request.auth.token.email
          && exists(/databases/$(database)/documents/users/$(data.userId))
          && getAfter(/databases/$(database)/documents/users/$(data.userId)).data.email == request.auth.token.email
          && getAfter(/databases/$(database)/documents/users/$(data.userId)).data.companyId == data.companyId
          // Phase 1 (Master Plan §3.2/§9.2): user_auth_maps mirrors
          // users.groupId, validated the same way companyId is today. groupId
          // is Optional (pre-backfill window) — but when the mapping carries
          // one it must match the linked users doc's groupId, gated on field
          // presence (the fail-closed missing-field idiom used throughout).
          && (!data.keys().hasAny(['groupId'])
            || (getAfter(/databases/$(database)/documents/users/$(data.userId)).data.keys().hasAny(['groupId'])
              && getAfter(/databases/$(database)/documents/users/$(data.userId)).data.groupId == data.groupId));
      }
      allow get: if signedIn() && authUid == request.auth.uid;
      allow list: if false;
      allow create: if validOwnMapping(request.resource.data);
      allow update: if validOwnMapping(request.resource.data)
        && request.resource.data.authUid == resource.data.authUid
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.companyId == resource.data.companyId
        // Phase 1: groupId immutable once set (Optional, Immutable per §3.2).
        && (!resource.data.keys().hasAny(['groupId']) || request.resource.data.groupId == resource.data.groupId);
      allow delete: if false;
    }

    match /dispatch/{dispatchId} {
      // Phase 3 (F-07, §8.1/§8.3): dispatch is warehouse-scoped — a
      // warehouse-operational actor only sees/creates/updates dispatches of
      // their OWN warehouse. Non-restricted roles keep their existing
      // company/group-wide scope (§8.2/§8.4); owner/Super Admin bypass.
      allow read: if actorIsActive() && (canReadCompanyScoped() || groupAdminCanRead(resource.data))
        && sameWarehouse(resource.data);
      allow create: if actorIsActive() && warehouseActorCanCreate(request.resource.data)
        && request.resource.data.createdBy == actorUserId()
        // F-08-class FK: the dispatch's source warehouse must exist AND belong
        // to the same Company (forged cross-company warehouseId rejected).
        && warehouseBelongsToCompany(request.resource.data)
        && sameWarehouse(request.resource.data);
      allow update: if actorIsActive() && warehouseActorCanUpdate(resource.data)
        // warehouseId immutable — a dispatch can never be re-pointed at
        // another warehouse (escalation via update rejected).
        && warehouseIdUnchanged()
        && sameWarehouse(resource.data)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['deliveryOTPHash'])
        && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['deliveryConfirmed', 'closedAt', 'closedBy'])
          || isAdmin()
          || roleMatches('.*Account.*')
          || roleMatches('.*Sales.*')
          || roleMatches('.*Dispatch.*')
          || roleMatches('.*Warehouse.*')
        );
      allow delete: if false;
    }

    match /stock/{stockId} {
      // Phase 3 (F-07, Master Plan §8.1/§8.3): the warehouse tier lands on
      // stock. A warehouse-operational actor (role Warehouse/Operations with a
      // warehouseId assignment) is scoped to their own warehouse by
      // sameWarehouse() — another warehouse's stock in the SAME company is
      // DENIED (previously allowed: the F-07 hole). Every other role passes
      // through unchanged (§8.2/§8.4: Admin/GroupAdmin/Director/Manager keep
      // company/group-wide visibility; owner/Super Admin bypass). The
      // warehouseId constraint must appear in the client query for list
      // provability (src/lib/firestore.ts companyScopedQuery §8.3).
      //
      // `resource == null` guard (same established pattern as companies/
      // roles/users/settings above): stockIn()/useSaveStockEntry() both
      // transaction.get() the deterministic stockSummaryId(companyId,
      // productId, warehouseId) doc BEFORE writing, to compute the new
      // quantity from any existing summary — a read that is a routine part
      // of every stock movement, not an optional probe. Without this guard,
      // canReadCompanyScoped()/groupAdminCanRead()/sameWarehouse() all
      // dereference resource.data, which is undefined when the summary
      // doesn't exist yet (the FIRST stock movement ever recorded for a
      // given product+warehouse pair — e.g. a brand-new tenant's very first
      // "Add Stock"), so the rule evaluated to a hard deny regardless of
      // role, company, or group — this was never actually a Group Admin
      // permission gap; every actor's first stock entry for a new
      // product/warehouse pair failed identically. A missing doc holds zero
      // data, so `resource == null` grants nothing once it does exist.
      allow read: if actorIsActive() && (
        resource == null
        || ((canReadCompanyScoped() || groupAdminCanRead(resource.data)) && sameWarehouse(resource.data))
      );
      allow create: if actorIsActive() && warehouseActorCanCreate(request.resource.data)
        // F-08-class FK: the referenced warehouse must exist AND belong to the
        // same Company (a forged cross-company warehouseId is rejected).
        && warehouseBelongsToCompany(request.resource.data)
        && sameWarehouse(request.resource.data);
      allow update: if actorIsActive() && warehouseActorCanUpdate(resource.data)
        // warehouseId is immutable once created — re-pointing a stock summary
        // at another warehouse (escalation via update) is rejected.
        && warehouseIdUnchanged()
        && sameWarehouse(resource.data)
        && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['availableQty', 'reservedQty'])
          || actorRoleMatches('.*Warehouse.*')
          || actorRoleMatches('.*Operations.*')
          // Admin OR GroupAdmin, via ONE call to the same lean,
          // authMapPath()-cached actorRoleMatches() helper already used for
          // Warehouse/Operations above — deliberately NOT isAdmin() and NOT
          // groupAdminCanUpdate(). Two compounding findings here, live-
          // verified 2026-08-21 (admin@neozy.in / Ashish Enterprises), NEITHER
          // of them actually about Group Admin scoping being wrong:
          //
          // 1. isAdmin() checks currentUser().role == 'Admin' literally, so
          //    it never matched a 'GroupAdmin' actor — the originally
          //    reported symptom ("Group Admin cannot Adjust Stock").
          //
          // 2. Fixing that with the logically-correct groupAdminCanUpdate()
          //    (or even two separate actorRoleMatches() calls) still failed
          //    — with Firestore's own "maximum of 1000 expressions...
          //    reached" error. Reproduced directly against the emulator with
          //    the real two-document transaction shape (stock_ledger create
          //    + stock update, exactly as useSaveStockEntry()/stockIn()
          //    issue it): a PLAIN 'Admin' actor (no GroupAdmin involved at
          //    all) hit the IDENTICAL limit on the IDENTICAL transaction —
          //    this is a PRE-EXISTING cost problem in this collection's
          //    rules, compounded by the generic wildcard fallback's
          //    documented (see match /{collectionId}/{documentId} below)
          //    non-short-circuiting re-evaluation of
          //    canUpdateCompanyScoped()/groupAdminCanUpdate() for every write
          //    to a "special" collection, even though that fallback can
          //    never actually grant stock/stock_ledger access. Never caught
          //    before because no existing test exercised the real
          //    two-document transaction (every prior stock rules test used a
          //    single-document setDoc()).
          //
          // The fix that stayed under budget for BOTH roles: a single
          // actorRoleMatches('Admin|GroupAdmin') call. isAdmin()'s only
          // value beyond a plain role check — its isOwnerIdentity()/
          // isSuperAdmin() bypass — is already redundant here, since
          // warehouseActorCanUpdate() above already grants access via its
          // OWN isOwnerIdentity()/actorIsSuperAdmin() branches before this
          // clause is even reached; and two separate actorRoleMatches()
          // calls cost enough extra to matter, so they're combined into one.
          || actorRoleMatches('Admin|GroupAdmin')
        );
      allow delete: if false;
    }

    match /stock_ledger/{ledgerId} {
      // Phase 3 (F-07): stock_ledger is the movement ledger of stock — it
      // carries warehouseId and is directly warehouse-scoped, so the same
      // sameWarehouse() read restriction applies (a Warehouse-role actor must
      // not infer another warehouse's movements through the ledger path).
      allow read: if actorIsActive() && (canReadCompanyScoped() || groupAdminCanRead(resource.data))
        && sameWarehouse(resource.data);
      allow create: if actorIsActive() && warehouseActorCanCreate(request.resource.data)
        && request.resource.data.transactionId is string
        && request.resource.data.movementAt != null
        && warehouseBelongsToCompany(request.resource.data)
        && sameWarehouse(request.resource.data);
      allow update, delete: if false;
    }

    match /notifications/{notificationId} {
      function canSeeNotification(data) {
        return sameCompany(data)
          && (
            data.recipientUserId == currentUserId()
            || data.createdBy == currentUserId()
            || (data.visibleTo is list && currentUserId() in data.visibleTo)
            || isAdmin()
          );
      }
      allow read: if actorIsActive() && signedIn()
        && (canSeeNotification(resource.data) || groupAdminCanRead(resource.data));
      allow create: if actorIsActive() && (canCreateCompanyScoped() || groupAdminCanCreate(request.resource.data));
      allow update: if actorIsActive() && signedIn()
        && (canSeeNotification(resource.data) || groupAdminCanRead(resource.data))
        && (sameCompany(request.resource.data) || (isGroupAdmin() && sameGroup(request.resource.data) && groupIdUnchanged()))
        && companyIdUnchanged()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead', 'readAt', 'updatedAt', 'isDeleted', 'deletedAt', 'deletedBy']);
      allow delete: if false;
    }

    match /tasks/{taskId} {
      allow read: if actorIsActive() && (canReadCompanyScoped() || groupAdminCanRead(resource.data));
      allow create: if actorIsActive() && (canCreateCompanyScoped() || groupAdminCanCreate(request.resource.data));
      allow update: if actorIsActive() && (canUpdateCompanyScoped() || groupAdminCanUpdate(resource.data));
      allow delete: if false;
    }

    match /customer_phone_locks/{lockId} {
      // get() of a NOT-YET-CREATED deterministically-keyed lock
      // ({companyId}_{phone}) is the FIRST read every Customer-creation
      // transaction makes (useCustomers.createCustomerProjectionInTransaction's
      // uniqueness check). resource.data is null for a missing doc, so a bare
      // canReadCompanyScoped()/groupAdminCanRead() raises a "Null value error"
      // and denies the whole transaction for EVERY role — the same
      // permission-denied-storm class already fixed on `settings`, `roles` and
      // `companies` with this exact `resource == null` guard. A missing doc
      // holds zero data, so it grants nothing once the lock actually exists.
      allow read: if actorIsActive() && (resource == null || canReadCompanyScoped() || groupAdminCanRead(resource.data));
      allow create: if actorIsActive() && (canCreateCompanyScoped() || groupAdminCanCreate(request.resource.data))
        && request.resource.data.id == lockId
        && request.resource.data.phone is string
        && request.resource.data.customerId is string;
      allow update: if actorIsActive() && (canUpdateCompanyScoped() || groupAdminCanUpdate(resource.data))
        && resource.data.id == lockId
        && request.resource.data.id == lockId
        && request.resource.data.phone == resource.data.phone
        && request.resource.data.customerId == resource.data.customerId;
      allow delete: if false;
    }

    match /error_logs/{logId} {
      allow read: if actorIsActive() && ((isAdmin() && canReadCompanyScoped()) || groupAdminCanRead(resource.data));
      allow create: if actorIsActive() && (canCreateCompanyScoped() || groupAdminCanCreate(request.resource.data));
      allow update, delete: if false;
    }

    match /channel_partners/{partnerId} {
      // Phase 1: partner self-read resolves through the canonical identity
      // relationship (users.channelPartnerId → channel_partners/{id}) in
      // addition to the legacy partner-side userId field. Company-scoped
      // admin/management access (existing architecture) is unchanged.
      allow read: if actorIsActive() && ((canReadCompanyScoped() || groupAdminCanRead(resource.data))
        || (isPartner() && (resource.data.userId == currentUserId() || partnerLinkedToSelf(partnerId))));
      allow create: if actorIsActive() && (canCreateCompanyScoped() || groupAdminCanCreate(request.resource.data));
      // Phase 1: the partner-side userId link is immutable once established
      // (only linkPartnerUser may set it — absent/'' -> value is the first
      // controlled link; a real value can never change via a direct write).
      allow update: if (canUpdateCompanyScoped() || groupAdminCanUpdate(resource.data)) && partnerUserIdUnchanged();
      allow delete: if false;
    }

    // ── Phase 6 — explicit match for scheme_registrations (Vendor Lock /
    // Scheme Registration). Overrides the generic catch-all (the collection
    // is in isSpecialCollection, so the wildcard denies it) and enforces the
    // partner/team/Director/Admin scope + write restrictions at rules level
    // — never frontend-only security. Director is VIEW-ONLY (spec §18): no
    // write branch mentions it. Accounts gets no access. Cross-company is
    // denied by sameCompany() everywhere. Vendor Lock irreversibility is a
    // service-machine contract (statuses), not enumerable in rules.
    match /scheme_registrations/{id} {
      allow read: if actorIsActive() && signedIn() && (schemeRegCanRead(resource.data) || groupAdminCanRead(resource.data));
      allow create: if actorIsActive() && signedIn()
        && (
          (sameCompany(request.resource.data)
            && (isAdmin() || schemeRegPartnerOwnsProject(request.resource.data) || schemeRegManagerOwnsProject(request.resource.data)))
          || (isGroupAdmin() && sameGroup(request.resource.data))
        )
        && groupIdMatchesCompany(request.resource.data);
      // Partner self-edit: own record only, pre-completion states only
      // (Draft/Submitted/Rejected/Failed sources) with partner-side targets
      // (Draft/Submitted/Cancelled), identity fields immutable. Staff
      // (Manager team / Admin) may manage team records — the service
      // enforces the exact status machine + approval permission. Group Admin
      // is Admin-equivalent (§5.2): same Group-scope, identity still immutable.
      allow update: if actorIsActive() && signedIn() && schemeRegIdentityUnchanged()
        && (
          (sameCompany(request.resource.data) && companyIdUnchanged()
            && (
              (isAdmin() || (isSchemeRegManagerRole() && schemeRegManagerOfPartner(resource.data.partnerId)))
              || (
                isPartner() && partnerLinkedToSelf(resource.data.partnerId)
                && resource.data.status in ['Draft', 'Submitted', 'Rejected', 'Failed']
                && request.resource.data.status in ['Draft', 'Submitted', 'Cancelled']
              )
            ))
          || (isGroupAdmin() && sameGroup(resource.data) && sameGroup(request.resource.data) && groupIdUnchanged())
        )
        && groupIdMatchesCompany(request.resource.data);
      // Protected records: hard delete is Admin-only (the audited override
      // path); everyone else must use the workflow's terminal transitions.
      // Group Admin inherits the Admin hard-delete per §5.2 (Group-scoped).
      allow delete: if actorIsActive() && ((isAdmin() && sameCompany(resource.data)) || (isGroupAdmin() && sameGroup(resource.data)));
    }

    match /partner_wallet_transactions/{txnId} {
      // Company-scoped access for admin/finance/manager.
      // Partner-specific read filtering happens at the application layer (hooks).
      // In Phase 5 (wallet implementation), introduce a get() resolver to
      // cross-reference partnerId -> channel_partners/{partnerId}.userId == currentUserId()
      allow read: if actorIsActive() && (canReadCompanyScoped() || groupAdminCanRead(resource.data));
      allow create: if actorIsActive() && (canCreateCompanyScoped() || groupAdminCanCreate(request.resource.data));
      allow update: if actorIsActive() && ((isAdmin() && sameCompany(resource.data) && sameCompany(request.resource.data) && companyIdUnchanged()) || groupAdminCanUpdate(resource.data))
        && groupIdMatchesCompany(request.resource.data);

      allow delete: if false;
    }

    match /commission_rules/{ruleId} {
      // F-03 (Phase 0): commission_rules read is company-scoped. Phase 2
      // (§5.2/§9.3): Group Admin inherits Admin grants Group-scoped, so
      // create/update gain the sameGroup() additive-OR.
      allow read: if actorIsActive() && (canReadCompanyScoped() || groupAdminCanRead(resource.data));
      // Ternary discriminator (same 2026-08-19 expression-budget root cause
      // as the users/{userId} and audit_logs/security_logs create rules) —
      // `||` did not reliably short-circuit sameCompany() once isAdmin()
      // resolved false.
      allow create: if actorIsActive()
        && (isGroupAdmin() ? sameGroup(request.resource.data) : (isAdmin() && sameCompany(request.resource.data)))
        && groupIdMatchesCompany(request.resource.data);
      allow update: if actorIsActive() && ((isAdmin() && sameCompany(resource.data) && companyIdUnchanged()) || groupAdminCanUpdate(resource.data))
        && groupIdMatchesCompany(request.resource.data);
      allow delete: if false;
    }

    match /tax_invoices/{invoiceId} {
      allow read: if actorIsActive() && (canReadCompanyScoped() || groupAdminCanRead(resource.data));
      allow create: if actorIsActive() && (canCreateCompanyScoped() || groupAdminCanCreate(request.resource.data)) && request.resource.data.status == 'Draft';
      allow update: if actorIsActive() && (canUpdateCompanyScoped() || groupAdminCanUpdate(resource.data))
        && (
          (resource.data.status == 'Draft' && request.resource.data.status in ['Draft', 'Issued', 'Cancelled'])
          || (resource.data.status == 'Issued' && request.resource.data.status == 'Cancelled')
        );
      allow delete: if false;
    }

    // ── Security Remediation Phase 2 (F-06/RULES-001, docs/audits/
    // NEOZY_SECURITY_REMEDIATION_PHASE_2_IMPLEMENTATION_CONTRACT.md): the
    // generic company-scoped fallback (canReadCompanyScoped()/
    // canCreateCompanyScoped()/canUpdateCompanyScoped(), see the
    // match /{collectionId}/{documentId} fallback below) enforces tenant
    // membership but not role — ANY active same-company user could read/
    // write these 6 financial/HR collections via a direct SDK call,
    // bypassing the UI's canDo() gating entirely. Explicit role-aware
    // blocks below close this for exactly these 6 collections (the ones
    // the Phase 1 audit found to be genuinely role-restricted in the
    // actual seeded role grants — src/lib/roleBootstrap.ts — not merely
    // company-restricted). Every other collection is deliberately left on
    // the generic fallback unchanged — this is not a general RBAC rewrite.
    //
    // Pattern: an isGroupAdmin() TERNARY discriminator, not an `||` of
    // canXCompanyScoped()/groupAdminCanX() — this file's own commission_rules
    // block (§ above) already documents that `||` does not reliably
    // short-circuit in this rules engine once the first branch resolves
    // false, and a first attempt at these 6 blocks using that `||` shape
    // measurably hit "maximum of 1000 expressions" on every write during
    // emulator verification (both canXCompanyScoped() AND groupAdminCanX()
    // were being evaluated, stacked with isAdmin()+isGroupAdmin()+
    // roleMatches() — 5 heavy calls). The ternary evaluates exactly ONE
    // tenant-check branch. isAdmin() already folds in isOwnerIdentity()/
    // isSuperAdmin(), so no separate Owner/SuperAdmin bypass is needed
    // here. Never a dynamic roles/{id}.permissions get() — role gates are
    // plain roleMatches() role-NAME checks, the same cheap pattern already
    // proven in dispatch/stock/scheme_registrations.

    match /employees/{employeeId} {
      // Role grants (roleBootstrap.ts): Admin (full, via createAllModulePermissions()),
      // GroupAdmin (own Group, scope extension — no separate role check),
      // HR (view/create/edit/delete), Director (view only). No other
      // seeded role has any `employees` grant.
      // Expression-budget note: role gates use the LEAN actorIsSuperAdmin()/
      // actorRoleMatches() pair (the documented F4/G2/J2/K3-safe pattern this
      // file already uses for `stock`/warehouse rules), not isSuperAdmin()/
      // roleMatches() — those re-enter hasUserProfile()/currentUser() on
      // every call and, combined with canUpdateCompanyScoped()'s own
      // sameCompany()x2 + groupIdMatchesCompany() cost plus the generic
      // fallback's redundant re-evaluation (documented on `stock`), pushed
      // UPDATE past Firestore's 1000-expression cap.
      allow read: if actorIsActive()
        && (isGroupAdmin() ? groupAdminCanRead(resource.data) : (sameCompany(resource.data) && (actorIsSuperAdmin() || actorRoleMatches('Admin|HR|Director'))));
      allow create: if actorIsActive()
        && (isGroupAdmin() ? groupAdminCanCreate(request.resource.data) : (canCreateCompanyScoped() && (actorIsSuperAdmin() || actorRoleMatches('Admin|HR'))));
      allow update: if actorIsActive()
        && (isGroupAdmin() ? groupAdminCanUpdate(resource.data) : (isOwnerIdentity() || actorIsSuperAdmin() || (tenantWriteCanUpdate(resource.data) && actorRoleMatches('Admin|HR'))));
      allow delete: if false;
    }

    match /payroll/{payrollId} {
      // Role grants: Admin (full), GroupAdmin (own Group), HR (view only,
      // explicit), Director (view only). No non-Admin role has payroll
      // create/edit/delete today — write is Admin/GroupAdmin-only.
      allow read: if actorIsActive()
        && (isGroupAdmin() ? groupAdminCanRead(resource.data) : (sameCompany(resource.data) && (actorIsSuperAdmin() || actorRoleMatches('Admin|HR|Director'))));
      allow create: if actorIsActive()
        && (isGroupAdmin() ? groupAdminCanCreate(request.resource.data) : (canCreateCompanyScoped() && (actorIsSuperAdmin() || actorRoleMatches('Admin'))));
      allow update: if actorIsActive()
        && (isGroupAdmin() ? groupAdminCanUpdate(resource.data) : (isOwnerIdentity() || actorIsSuperAdmin() || (tenantWriteCanUpdate(resource.data) && actorRoleMatches('Admin'))));
      allow delete: if false;
    }

    match /payments/{paymentId} {
      // Role grants: Admin (full), GroupAdmin (own Group), Accounts (full
      // CRUD), Director (view only). No other seeded role has any
      // `payments` grant.
      allow read: if actorIsActive()
        && (isGroupAdmin() ? groupAdminCanRead(resource.data) : (sameCompany(resource.data) && (actorIsSuperAdmin() || actorRoleMatches('Admin|Accounts|Director'))));
      allow create: if actorIsActive()
        && (isGroupAdmin() ? groupAdminCanCreate(request.resource.data) : (canCreateCompanyScoped() && (actorIsSuperAdmin() || actorRoleMatches('Admin|Accounts'))));
      allow update: if actorIsActive()
        && (isGroupAdmin() ? groupAdminCanUpdate(resource.data) : (isOwnerIdentity() || actorIsSuperAdmin() || (tenantWriteCanUpdate(resource.data) && actorRoleMatches('Admin|Accounts'))));
      allow delete: if false;
    }

    match /banks/{bankId} {
      // Role grants: Admin (full), GroupAdmin (own Group), Sales/Accounts/
      // Director/Manager (view only). No non-Admin role has banks
      // create/edit/delete today — write is Admin/GroupAdmin-only.
      allow read: if actorIsActive()
        && (isGroupAdmin() ? groupAdminCanRead(resource.data) : (sameCompany(resource.data) && (actorIsSuperAdmin() || actorRoleMatches('Admin|Sales|Accounts|Director|Manager'))));
      allow create: if actorIsActive()
        && (isGroupAdmin() ? groupAdminCanCreate(request.resource.data) : (canCreateCompanyScoped() && (actorIsSuperAdmin() || actorRoleMatches('Admin'))));
      allow update: if actorIsActive()
        && (isGroupAdmin() ? groupAdminCanUpdate(resource.data) : (isOwnerIdentity() || actorIsSuperAdmin() || (tenantWriteCanUpdate(resource.data) && actorRoleMatches('Admin'))));
      allow delete: if false;
    }

    match /commission_records/{recordId} {
      // Governed by the 'partners' permissions.ts module — confirmed via
      // routes.tsx's RoleRoute module="partners" gate on every Settlements/
      // Commission page. Role grants: Admin (full), GroupAdmin (own Group),
      // Manager (view/create/edit, team-scope at the app layer), Partner
      // (view, self-scope at the app layer), Director (view only). This
      // rules-layer gate is deliberately coarse (company/role boundary
      // only) — it does NOT replicate Manager's team-scope or Partner's
      // self-scope narrowing, matching the existing dispatch/stock
      // precedent where visibility scoping stays an application-layer
      // concern (canDo()'s `visibility` field + applyAccessFilters), never
      // a Firestore-rules concept, to avoid the extra get() calls a
      // per-record ownership check would require.
      allow read: if actorIsActive()
        && (isGroupAdmin() ? groupAdminCanRead(resource.data) : (sameCompany(resource.data) && (actorIsSuperAdmin() || actorRoleMatches('Admin|Manager|Partner|Director'))));
      allow create: if actorIsActive()
        && (isGroupAdmin() ? groupAdminCanCreate(request.resource.data) : (canCreateCompanyScoped() && (actorIsSuperAdmin() || actorRoleMatches('Admin|Manager'))));
      allow update: if actorIsActive()
        && (isGroupAdmin() ? groupAdminCanUpdate(resource.data) : (isOwnerIdentity() || actorIsSuperAdmin() || (tenantWriteCanUpdate(resource.data) && actorRoleMatches('Admin|Manager'))));
      allow delete: if false;
    }

    match /settlements/{settlementId} {
      // Identical authorization shape to commission_records — same
      // governing 'partners' module, same routes.tsx module="partners" gate.
      allow read: if actorIsActive()
        && (isGroupAdmin() ? groupAdminCanRead(resource.data) : (sameCompany(resource.data) && (actorIsSuperAdmin() || actorRoleMatches('Admin|Manager|Partner|Director'))));
      allow create: if actorIsActive()
        && (isGroupAdmin() ? groupAdminCanCreate(request.resource.data) : (canCreateCompanyScoped() && (actorIsSuperAdmin() || actorRoleMatches('Admin|Manager'))));
      allow update: if actorIsActive()
        && (isGroupAdmin() ? groupAdminCanUpdate(resource.data) : (isOwnerIdentity() || actorIsSuperAdmin() || (tenantWriteCanUpdate(resource.data) && actorRoleMatches('Admin|Manager'))));
      allow delete: if false;
    }

    match /document_counters/{counterId} {
      // Phase 1: document_counters is a §3.2 denormalized collection, so new
      // counter docs carry groupId (write-helper stamped). The shape
      // allow-list therefore includes 'groupId'; the tenant anchor is split
      // (sameCompany for Company Admins, groupAdminCanCreate for Group
      // Admins) so a Group Admin can drive numbering in any Company of their
      // Group. The legacy direct-transaction path (documentNumbering.ts,
      // merge:true) writes no groupId on a brand-new counter — accepted by
      // the same shape (field optional); such docs simply have no Group-admin
      // reach until the next denormalization pass touches them.
      function validCounterShape() {
        return signedIn()
          && request.resource.data.keys().hasOnly(['id', 'companyId', 'groupId', 'docType', 'currentNumber', 'prefix', 'sequencePadding', 'createdAt', 'updatedAt', 'isDeleted'])
          && request.resource.data.id == counterId
          && request.resource.data.companyId is string
          && request.resource.data.docType in ['invoice', 'quotation', 'order']
          && request.resource.data.currentNumber is number
          && request.resource.data.currentNumber >= 1
          && request.resource.data.prefix is string
          && request.resource.data.sequencePadding is number;
      }

      function validCounterPayload() {
        return validCounterShape() && sameCompany(request.resource.data);
      }

      allow read: if actorIsActive() && (canReadCompanyScoped() || groupAdminCanRead(resource.data));
      allow create: if actorIsActive()
        && ((canCreateCompanyScoped() && validCounterPayload()) || (groupAdminCanCreate(request.resource.data) && validCounterShape()))
        && request.resource.data.currentNumber == 1;
      allow update: if actorIsActive()
        && ((canCreateCompanyScoped() && validCounterPayload()) || (groupAdminCanCreate(request.resource.data) && validCounterShape()))
        && resource.data.companyId == request.resource.data.companyId
        && resource.data.docType == request.resource.data.docType
        && resource.data.id == request.resource.data.id
        && request.resource.data.currentNumber == resource.data.currentNumber + 1;
      allow delete: if false;
    }

    match /projects/{projectId} {
      allow read: if actorIsActive() && signedIn() && (canReadProjectScoped(resource.data) || groupAdminCanRead(resource.data));
      allow create: if actorIsActive() && (canCreateCompanyScoped() || groupAdminCanCreate(request.resource.data)) && request.resource.data.projectId == projectId;
      allow update: if actorIsActive() && (canUpdateCompanyScoped() || groupAdminCanUpdate(resource.data))
        && request.resource.data.projectId == resource.data.projectId;
      allow delete: if false;
    }

    match /surveys/{documentId} {
      allow read: if actorIsActive() && signedIn() && (canReadProjectScoped(resource.data) || groupAdminCanRead(resource.data));
      allow create: if actorIsActive() && (canCreateCompanyScoped() || groupAdminCanCreate(request.resource.data))
        && request.resource.data.surveyId == documentId
        && request.resource.data.projectId is string
        && request.resource.data.assignedSurveyor == request.resource.data.surveyorId;
      allow update: if actorIsActive() && (canUpdateCompanyScoped() || groupAdminCanUpdate(resource.data))
        && request.resource.data.surveyId == resource.data.surveyId
        && request.resource.data.projectId == resource.data.projectId;
      allow delete: if false;
    }

    match /engineering_designs/{documentId} {
      allow read: if actorIsActive() && signedIn() && (canReadProjectScoped(resource.data) || groupAdminCanRead(resource.data));
      allow create: if actorIsActive() && (canCreateCompanyScoped() || groupAdminCanCreate(request.resource.data))
        && request.resource.data.designId == documentId
        && request.resource.data.projectId is string
        && request.resource.data.surveyId is string
        && request.resource.data.designerId is string;
      allow update: if actorIsActive() && (canUpdateCompanyScoped() || groupAdminCanUpdate(resource.data))
        && request.resource.data.designId == resource.data.designId
        && request.resource.data.projectId == resource.data.projectId
        && request.resource.data.surveyId == resource.data.surveyId;
      allow delete: if false;
    }

    match /purchase_orders/{documentId} {
      function validPurchaseOrderTransition(from, to) {
        return (from == 'Draft' && to in ['Sent', 'Cancelled'])
          || (from == 'Sent' && to in ['PartiallyReceived', 'Received', 'Cancelled'])
          || (from == 'PartiallyReceived' && to in ['Received', 'Cancelled']);
      }

      allow read: if actorIsActive() && (canReadCompanyScoped() || groupAdminCanRead(resource.data));
      allow create: if actorIsActive() && (canCreateCompanyScoped() || groupAdminCanCreate(request.resource.data))
        && request.resource.data.purchaseOrderId == documentId
        && request.resource.data.vendorId is string
        && request.resource.data.status == 'Draft'
        && request.resource.data.items is list;
      allow update: if actorIsActive() && (canUpdateCompanyScoped() || groupAdminCanUpdate(resource.data))
        && request.resource.data.purchaseOrderId == resource.data.purchaseOrderId
        && request.resource.data.vendorId is string
        && request.resource.data.items is list
        && (
          (resource.data.status == 'Draft' && request.resource.data.status == 'Draft')
          || validPurchaseOrderTransition(resource.data.status, request.resource.data.status)
        );
      allow delete: if false;
    }

    match /goods_receipts/{documentId} {
      // Phase 3 (F-07, §8.1/§8.3): goods_receipts carries the receiving
      // warehouseId and is warehouse-scoped — a warehouse-operational actor
      // only sees/receives goods into their OWN warehouse. Non-restricted
      // roles keep their existing company-wide scope (§8.2/§8.4).
      allow read: if actorIsActive() && (canReadCompanyScoped() || groupAdminCanRead(resource.data))
        && sameWarehouse(resource.data);
      allow create: if actorIsActive() && warehouseActorCanCreate(request.resource.data)
        && request.resource.data.goodsReceiptId == documentId
        && request.resource.data.purchaseOrderId is string
        && request.resource.data.warehouseId is string
        // F-08-class FK: the receiving warehouse must exist AND belong to the
        // same Company (forged cross-company warehouseId rejected).
        && warehouseBelongsToCompany(request.resource.data)
        && sameWarehouse(request.resource.data)
        && request.resource.data.receivedBy == actorUserId()
        && request.resource.data.receivedItems is list
        && request.resource.data.receivedItems.size() > 0
        && request.resource.data.stockEntries is list;
      allow update, delete: if false;
    }

    match /installations/{documentId} {
      allow read: if actorIsActive() && signedIn() && (canReadProjectScoped(resource.data) || groupAdminCanRead(resource.data));
      allow create: if actorIsActive() && (canCreateCompanyScoped() || groupAdminCanCreate(request.resource.data));
      allow update: if actorIsActive() && (canUpdateCompanyScoped() || groupAdminCanUpdate(resource.data));
      allow delete: if false;
    }

    // Phase 13 (Blueprint §13): permanent delete is Super-Admin-only,
    // everywhere else `allow delete: if false` (soft delete via `isDeleted`
    // is the only normal-user path). product_categories is the one
    // collection with a real client-side hard-delete affordance (category
    // "Delete"/"Merge" — src/pages/CategoriesWorkspace.tsx), so it is the
    // one collection that needs a real, narrowly-scoped delete allowance
    // rather than the universal `if false` — reusing isSuperAdmin(), not a
    // new authorization mechanism.
    match /product_categories/{documentId} {
      allow read: if actorIsActive() && (canReadCompanyScoped() || groupAdminCanRead(resource.data));
      allow create: if actorIsActive() && (canCreateCompanyScoped() || groupAdminCanCreate(request.resource.data));
      allow update: if actorIsActive() && (canUpdateCompanyScoped() || groupAdminCanUpdate(resource.data));
      // Permanent delete stays Super-Admin-only (Blueprint §13) — Group Admin
      // does not inherit it (delete is not an Admin grant here either).
      allow delete: if actorIsActive() && isSuperAdmin() && sameCompany(resource.data);
    }

    match /service_tickets/{documentId} {
      allow read: if actorIsActive() && signedIn() && (canReadProjectScoped(resource.data) || groupAdminCanRead(resource.data));
      allow create: if actorIsActive() && (canCreateCompanyScoped() || groupAdminCanCreate(request.resource.data));
      allow update: if actorIsActive() && (canUpdateCompanyScoped() || groupAdminCanUpdate(resource.data));
      allow delete: if false;
    }

    // The 7 collections below are all real, actively-written members of
    // src/lib/projectVisibility.ts's PROJECT_SCOPED_COLLECTIONS — the
    // client already queries them exclusively by PROJECT_ASSIGNMENT_FIELDS
    // (assignedSurveyor/assignedInstaller/salesOwner/designerId, the same
    // fields canReadProjectScoped checks). Previously none of the 7 had an
    // explicit match block, so they fell through to the generic wildcard
    // rule at the bottom of this file, which only enforces sameCompany() —
    // no ownership/assignment check. That meant a same-company user with a
    // narrow, field-execution role (Surveyor/Engineer/InstallationLead/
    // ServiceTechnician/ComplianceOfficer) could read every company
    // record in these collections via a direct SDK call, bypassing the
    // client's own query-level narrowing entirely. Matches the existing
    // installations/service_tickets pattern exactly.
    match /qc_checks/{documentId} {
      allow read: if actorIsActive() && signedIn() && (canReadProjectScoped(resource.data) || groupAdminCanRead(resource.data));
      allow create: if actorIsActive() && (canCreateCompanyScoped() || groupAdminCanCreate(request.resource.data));
      allow update: if actorIsActive() && (canUpdateCompanyScoped() || groupAdminCanUpdate(resource.data));
      allow delete: if false;
    }

    match /commissioning_records/{documentId} {
      allow read: if actorIsActive() && signedIn() && (canReadProjectScoped(resource.data) || groupAdminCanRead(resource.data));
      allow create: if actorIsActive() && (canCreateCompanyScoped() || groupAdminCanCreate(request.resource.data));
      allow update: if actorIsActive() && (canUpdateCompanyScoped() || groupAdminCanUpdate(resource.data));
      allow delete: if false;
    }

    match /net_metering_applications/{documentId} {
      allow read: if actorIsActive() && signedIn() && (canReadProjectScoped(resource.data) || groupAdminCanRead(resource.data));
      allow create: if actorIsActive() && (canCreateCompanyScoped() || groupAdminCanCreate(request.resource.data));
      allow update: if actorIsActive() && (canUpdateCompanyScoped() || groupAdminCanUpdate(resource.data));
      allow delete: if false;
    }

    match /subsidy_applications/{documentId} {
      allow read: if actorIsActive() && signedIn() && (canReadProjectScoped(resource.data) || groupAdminCanRead(resource.data));
      allow create: if actorIsActive() && (canCreateCompanyScoped() || groupAdminCanCreate(request.resource.data));
      allow update: if actorIsActive() && (canUpdateCompanyScoped() || groupAdminCanUpdate(resource.data));
      allow delete: if false;
    }

    match /project_handovers/{documentId} {
      allow read: if actorIsActive() && signedIn() && (canReadProjectScoped(resource.data) || groupAdminCanRead(resource.data));
      allow create: if actorIsActive() && (canCreateCompanyScoped() || groupAdminCanCreate(request.resource.data));
      allow update: if actorIsActive() && (canUpdateCompanyScoped() || groupAdminCanUpdate(resource.data));
      allow delete: if false;
    }

    match /amc_contracts/{documentId} {
      allow read: if actorIsActive() && signedIn() && (canReadProjectScoped(resource.data) || groupAdminCanRead(resource.data));
      allow create: if actorIsActive() && (canCreateCompanyScoped() || groupAdminCanCreate(request.resource.data));
      allow update: if actorIsActive() && (canUpdateCompanyScoped() || groupAdminCanUpdate(resource.data));
      allow delete: if false;
    }

    match /generation_readings/{documentId} {
      allow read: if actorIsActive() && signedIn() && (canReadProjectScoped(resource.data) || groupAdminCanRead(resource.data));
      allow create: if actorIsActive() && (canCreateCompanyScoped() || groupAdminCanCreate(request.resource.data));
      allow update: if actorIsActive() && (canUpdateCompanyScoped() || groupAdminCanUpdate(resource.data));
      allow delete: if false;
    }

    // ── Settings collection ────────────────────────────────
    // Public config only (no secrets) is stored here.
    // Read: any authenticated company member can read settings.
    // Write: requires Admin role (isAdmin()) + same company.
    // Admin enforcement is critical: without it, any user can write settings
    // including the adminOnly flag check bypass documented in P00 finding H02.
    match /settings/{documentId} {
      // Read: any authenticated company member can read settings. get() of a
      // NOT-YET-CREATED deterministically-keyed settings doc (e.g.
      // {companyId}_settings_general before first save) must return "not
      // found" instead of 403: the read rule validates resource.data.companyId,
      // which is null for a missing doc, so a bare canReadCompanyScoped()
      // denies it and the app logs a permission-denied storm. A missing doc
      // holds zero data, so `resource == null` grants nothing (list queries
      // still evaluate per-document against canReadCompanyScoped).
      allow get: if actorIsActive() && signedIn() && (resource == null || canReadCompanyScoped() || groupAdminCanRead(resource.data));
      allow list: if actorIsActive() && (canReadCompanyScoped() || groupAdminCanRead(resource.data));
      // `documentId == currentUserId() + '_settings_' + sectionId` is the
      // ENTIRE ownership proof: documentId is a Firestore path segment (not
      // client-forgeable), and currentUserId() is derived server-side from
      // request.auth.uid via the trusted user_auth_maps mapping — a
      // deterministic id match already means "this document belongs to the
      // requesting user," independent of any field inside the document.
      // A prior version additionally required data.updatedBy ==
      // currentUserId() — redundant with the id check above for a legitimate
      // client (both ultimately derive from currentUserId()), but a real
      // liability: scripts/backfill-group-denorm.cjs treated `settings` as a
      // generic tenant-scoped collection and stamped updatedBy:
      // 'system-backfill' onto every settings doc missing a groupId,
      // including personal (user-scoped) documents. That silently and
      // permanently locked every affected user out of saving their OWN
      // appearance/notifications settings ever again — the update rule below
      // requires isOwnPersonalSettings() to hold for BOTH resource.data (the
      // existing doc) and request.resource.data (the new one), and the
      // existing doc's stale updatedBy could never satisfy it again. Removing
      // this clause closes that self-lockout without weakening authorization
      // (the id-derived-from-auth check below is still airtight).
      // Parameterized over the SUBMITTED/EXISTING data's own `section` field
      // (still allowlisted to exactly the two self-service sections below)
      // instead of being called once per literal section name. Each call
      // chains several get()-heavy helpers (hasUserProfile/currentUserId/
      // sameCompany); calling it twice per side (once per hardcoded section
      // name, 4 times total for `update`) measurably approaches Firestore's
      // 1000-sub-expression-per-request budget for this rule — confirmed by
      // direct emulator reproduction of the real personal-settings update
      // path. Calling it once per side (2 times total for `update`) halves
      // that cost with an IDENTICAL security surface: `sectionId in
      // PERSONAL_SETTINGS_SECTIONS` still rejects any section other than the
      // two originally enumerated, and `documentId == currentUserId() +
      // '_settings_' + sectionId` is unchanged as the ownership proof.
      // F-13 budget engineering (same class of fix as usersUpdateAllowed()
      // above): isAdmin()/isSuperAdmin()/isGroupAdmin()/sameCompany()/
      // sameGroup() each independently re-fetch get(authMapPath()) and
      // get(users/{authMap.userId}) from scratch. The original create/update
      // rules called that chain via up to 4 separate helper invocations —
      // confirmed by direct emulator reproduction of the real reported
      // "Missing or insufficient permissions" failure to approach and exceed
      // Firestore's 1000-sub-expression-per-request budget for this rule
      // alone. Binding authMap/actor ONCE via `let` and reusing them below is
      // behaviorally identical to the original isAdmin()/isSuperAdmin()/
      // isGroupAdmin()/sameCompany()/sameGroup()/currentUserId() logic
      // (actorIsActive() — the outer gate on both allow clauses below —
      // already guarantees hasUserProfile() for every non-owner actor
      // reaching this point, which is exactly what those helpers required
      // internally anyway). companyGroupIsActive()/hasCompanyId()/
      // hasGroupId()/groupIdMatchesCompany() remain the exact same shared,
      // unmodified global helpers — only the redundant identity re-derivation
      // is eliminated, not the real (necessary) reads of the companies/groups
      // documents those helpers perform.
      function settingsCreateAllowed(data) {
        let authMap = get(authMapPath()).data;
        let actor = get(/databases/$(database)/documents/users/$(authMap.userId)).data;
        let ownerAwareUserId = isOwnerIdentity() ? 'owner:' + request.auth.uid : authMap.userId;
        let ownerOrSuper = isOwnerIdentity() || isSuperAdminFlag(actor);
        let dataSameCompany = ownerOrSuper || (hasCompanyId(data) && data.companyId == authMap.companyId && companyGroupIsActive(data));
        let dataSameGroup = ownerOrSuper || (actor.role == 'GroupAdmin' && hasGroupId(data)
          && authMap.keys().hasAny(['groupId']) && authMap.groupId is string && data.groupId == authMap.groupId);
        return ((isOwnerIdentity() || actor.role == 'Admin' || isSuperAdminFlag(actor)) && dataSameCompany)
          || (actor.role == 'GroupAdmin' && dataSameGroup)
          || (data.section in ['appearance', 'notifications']
            && documentId == ownerAwareUserId + '_settings_' + data.section
            && dataSameCompany);
      }
      function settingsUpdateAllowed(oldData, newData) {
        let authMap = get(authMapPath()).data;
        let actor = get(/databases/$(database)/documents/users/$(authMap.userId)).data;
        let ownerAwareUserId = isOwnerIdentity() ? 'owner:' + request.auth.uid : authMap.userId;
        let ownerOrSuper = isOwnerIdentity() || isSuperAdminFlag(actor);
        let oldSameCompany = ownerOrSuper || (hasCompanyId(oldData) && oldData.companyId == authMap.companyId && companyGroupIsActive(oldData));
        let newSameCompany = ownerOrSuper || (hasCompanyId(newData) && newData.companyId == authMap.companyId && companyGroupIsActive(newData));
        let oldSameGroup = ownerOrSuper || (actor.role == 'GroupAdmin' && hasGroupId(oldData)
          && authMap.keys().hasAny(['groupId']) && authMap.groupId is string && oldData.groupId == authMap.groupId);
        let newSameGroup = ownerOrSuper || (actor.role == 'GroupAdmin' && hasGroupId(newData)
          && authMap.keys().hasAny(['groupId']) && authMap.groupId is string && newData.groupId == authMap.groupId);
        return ((isOwnerIdentity() || actor.role == 'Admin' || isSuperAdminFlag(actor))
            && oldSameCompany && newSameCompany && companyIdUnchanged())
          || (actor.role == 'GroupAdmin'
            && oldSameGroup && newSameGroup && groupIdUnchanged() && companyIdUnchanged())
          || (oldData.section in ['appearance', 'notifications'] && newData.section == oldData.section
            && documentId == ownerAwareUserId + '_settings_' + oldData.section
            && oldSameCompany && newSameCompany && companyIdUnchanged());
      }
      allow create: if actorIsActive() && settingsCreateAllowed(request.resource.data)
        && groupIdMatchesCompany(request.resource.data);
      allow update: if actorIsActive() && settingsUpdateAllowed(resource.data, request.resource.data)
        && groupIdMatchesCompany(request.resource.data);
      allow delete: if false;
    }

    // ── Audit logs ─────────────────────────────────────────
    // Append-only: only Admin users may create entries (via trusted mutation
    // wrappers in settingsService, workflow, etc.). Non-admin users must never
    // be able to forge audit entries from the browser console.
    // No client may update or delete audit entries.
    match /demo_operations/{documentId} {
      allow read, write: if false;
    }

    match /audit_logs/{documentId} {
      allow read: if actorIsActive() && ((isAdmin() && canReadCompanyScoped()) || groupAdminCanRead(resource.data));
      // Ternary discriminator (see the users/{userId} create rule's root-
      // cause comment, 2026-08-19): `||` did not reliably short-circuit
      // sameCompany() once isAdmin() resolved false, and sameCompany()'s
      // companyGroupIsActive() touches the (large, logo-embedding)
      // companies/{companyId} document — a real GroupAdmin actor (e.g. the
      // audit-log write auditLogger.ts fires right after every successful
      // user creation) hit the same 1000-expression budget denial here. A
      // ternary is guaranteed lazy: exactly one arm evaluates.
      //
      // Self-authored activity entry (lib/workflow.ts logActivity, called on
      // EVERY Lead/Customer/Order/... mutation by EVERY role): a non-Admin
      // actor's own action log was denied here and only survived because
      // logActivity swallows the error — so the audit trail for anything a
      // Sales/Manager/Partner did was silently lost, and the raw
      // "Missing or insufficient permissions" surfaced in the console
      // (real-account repro, 2026-09-02). The added branch is deliberately
      // narrow and cannot forge history: append-only (update/delete stay
      // false), the entry's `userId` MUST equal the acting identity (no
      // impersonation), and it is company-scoped (auth-map companyId == the
      // entry's companyId — no cross-tenant reach). Reads stay Admin/
      // GroupAdmin-only, so a non-Admin can write their own trail but never
      // browse the log. LEAN: reads the self-owned auth map directly (the
      // actorGroupId()/actorUserId() pattern) — no currentUser()/sameCompany()
      // re-entry, keeping this rule well under the expression budget.
      allow create: if actorIsActive()
        && (
          (isGroupAdmin() ? sameGroup(request.resource.data) : (isAdmin() && sameCompany(request.resource.data)))
          || (
            hasAuthMap()
            && request.resource.data.userId == get(authMapPath()).data.userId
            && hasCompanyId(request.resource.data)
            && request.resource.data.companyId == get(authMapPath()).data.companyId
          )
        )
        && groupIdMatchesCompany(request.resource.data);
      allow update, delete: if false;
    }

    // F-04 (Phase 0): security_logs mirrors audit_logs exactly — Admin-only
    // create, fully immutable. Previously it inherited the generic fallback
    // (any same-company signed-in user could forge or tamper with security
    // events), defeating its purpose as a tamper-evident record. Phase 2:
    // Group Admin inherits the Admin grants Group-scoped (§5.2).
    match /security_logs/{documentId} {
      allow read: if actorIsActive() && ((isAdmin() && canReadCompanyScoped()) || groupAdminCanRead(resource.data));
      // Same ternary fix as audit_logs above (2026-08-19 root cause) —
      // auditLogger.ts's writeLog() dual-writes a security_logs entry for
      // 'critical' events (e.g. Group Admin granting a role), which hit the
      // identical expression-budget denial.
      allow create: if actorIsActive()
        && (isGroupAdmin() ? sameGroup(request.resource.data) : (isAdmin() && sameCompany(request.resource.data)))
        && groupIdMatchesCompany(request.resource.data);
      allow update, delete: if false;
    }

    // F-17 (Phase 0): device_tokens are personal — a user may only read,
    // create or update their OWN token records (userId-anchored), in addition
    // to the standard company scoping. Previously it inherited the generic
    // fallback with no per-user check, so any same-company user could read or
    // tamper with another user's FCM push-notification registrations.
    match /device_tokens/{tokenId} {
      allow read: if actorIsActive() && canReadCompanyScoped() && resource.data.userId == currentUserId();
      allow create: if actorIsActive() && canCreateCompanyScoped() && request.resource.data.userId == currentUserId();
      allow update: if actorIsActive() && canUpdateCompanyScoped() && resource.data.userId == currentUserId() && request.resource.data.userId == currentUserId();
      allow delete: if false;
    }

    // F-05 (Phase 0): backup_metadata is written only by the backup
    // automation's service-account identity (Admin SDK — bypasses rules by
    // design) and read only by Super Admin (Platform Dashboard). No client SDK
    // may create or mutate it.
    match /backup_metadata/{documentId} {
      allow read: if actorIsActive() && (isOwnerIdentity() || isSuperAdmin());
      allow create, update, delete: if false;
    }

    // Phase 4 (Master Plan §6.8/§6.9): platform_settings/global — the
    // Super Admin platform settings document (V1: maintenanceMode toggle +
    // maintenanceMessage). Super Admin/owner read+write only (the §6.9
    // emergency-control tier), never tenant-scoped, delete always forbidden.
    // Explicit authoritative block — platform_settings is in
    // isSpecialCollection() so the generic fallback can never OR-in a weaker
    // company-scoped grant (F-02 pattern). The doc id must match the path
    // segment (deterministic 'global' id), mirroring the groups id-anchor.
    match /platform_settings/{documentId} {
      allow read: if actorIsActive() && (isOwnerIdentity() || isSuperAdmin());
      allow create: if actorIsActive() && (isOwnerIdentity() || isSuperAdmin())
        && request.resource.data.id == documentId;
      allow update: if actorIsActive() && (isOwnerIdentity() || isSuperAdmin())
        && resource.data.id == documentId && request.resource.data.id == documentId;
      allow delete: if false;
    }

    // ── Geo Attendance Initiative — Phase 6: attendance ─────────────────
    // Dedicated rules block for the `attendance` collection, replacing the
    // generic wildcard's handling of this collection (audit §29.1, Risk #1).
    // Two co-existing write paths on the same document:
    //   1. Manual HR path (existing, unchanged): Admin/HR creates/updates
    //      status/inTime/outTime/notes via isAdmin() or attendance:edit permission.
    //   2. Self-service GPS path (new): employee creates their own check-in or
    //      updates their own check-out. Only checkIn/checkOut sub-object fields
    //      may be touched; once set, those fields are immutable (except via
    //      Admin-correction path).
    //   3. Admin-correction path (new): update of correction + any checkIn/checkOut
    //      fields allowed for isAdmin(), paired with mandatory auditLogger call.
    // audit_logs create rule is explicitly NOT changed (audit §29.2).
    //
    // LEAN self-service helper (Pre-Phase-11 gap closure): avoids the expensive
    // currentUser() chain (get(authMapPath) + get(users/{userId}) = ~300 exp)
    // by reading the auth-map doc directly (engine-cached, ~100 exp). The map's
    // userId and companyId are validated at WRITE TIME by validOwnMapping, so
    // the self-owned mapping is the authoritative identity anchor (same pattern
    // as actorGroupId/actorIsGroupAdmin).
    function isSelfServiceAttendanceWrite(data) {
      return hasAuthMap()
        && hasCompanyId(data)
        && data.companyId == get(authMapPath()).data.companyId
        && data.employeeId == get(authMapPath()).data.userId;
    }
    // Phase 15: Admin GPS-correction guard. When an Admin modifies checkIn or
    // checkOut (immutable self-service evidence), a correction with a non-empty
    // reason MUST be present in the same write. This closes the loophole that
    // would otherwise allow an Admin to silently alter GPS evidence without
    // documenting why. Admin updates to non-GPS fields (status, notes, etc.)
    // remain unrestricted.
    function requiresGPSReason(newData, oldData) {
      // Phase 15: When an Admin modifies EXISTING GPS evidence (checkIn/
      // checkOut that was already present with source:'gps'), a correction
      // with a non-empty reason MUST be present in the same write. This
      // closes the loophole that would otherwise allow an Admin to silently
      // alter GPS evidence without documenting why.
      //
      // Deliberately NOT triggered by:
      //  - a first-time add (oldData had no checkIn/checkOut yet) — this is
      //    an original entry (self-service markAttendance() or a fresh GPS
      //    write merged onto a manual record), not a correction of existing
      //    evidence.
      //  - modifying an existing sub-record whose OWN source is
      //    'manual_admin' — there is no GPS evidence to silently alter; it
      //    was never GPS in the first place.
      // Logic: NOT(existingGpsEvidenceChanged) OR correctionPresent.
      return !(
        (
          oldData.keys().hasAny(['checkIn']) && oldData.checkIn.source == 'gps'
          && newData.keys().hasAny(['checkIn']) && newData.checkIn != oldData.checkIn
        ) || (
          oldData.keys().hasAny(['checkOut']) && oldData.checkOut.source == 'gps'
          && newData.keys().hasAny(['checkOut']) && newData.checkOut != oldData.checkOut
        )
      ) || (
        newData.keys().hasAny(['correction'])
        && newData.correction.keys().hasAny(['reason'])
        && newData.correction.reason is string
        && newData.correction.reason.size() > 0
      );
    }
    // LEAN GroupAdmin scope check for `attendance` create/update, purpose-built
    // like `actorRoleMatches()` above. Live-verified 2026-08-21: the logically
    // "correct" full groupAdminCanCreate()/groupAdminCanUpdate() calls blow
    // Firestore's 1000-expression budget here — same fix class documented at
    // the `stock` quantity-update clause above (isAdmin()/groupAdminCanUpdate()
    // are each expensive multi-get() chains, and the generic wildcard
    // fallback below independently re-evaluates groupAdminCanCreate()/
    // groupAdminCanUpdate() for every write regardless of isSpecialCollection(),
    // compounding the cost). This keeps the same real security property
    // (actor is GroupAdmin AND the record's groupId equals the actor's own,
    // AND that Group is not suspended per §9.6) at a fraction of the cost —
    // it deliberately skips groupIdMatchesCompany()'s companyId/groupId
    // cross-check, which is STILL strictly more scoping than the existing
    // Admin branch below gets in this same rule (isAdmin() alone, no company
    // check at all — a pre-existing, separate condition, not introduced here).
    function attendanceGroupAdminScope(data) {
      return actorRoleMatches('GroupAdmin')
        && hasGroupId(data)
        && data.groupId == actorGroupId()
        && groupIsActive(data.groupId);
    }
    match /attendance/{id} {
      // READ: intentionally more restrictive than canReadCompanyScoped():
      // regular employees may ONLY read their own attendance (identity anchor),
      // not all company attendance. Admin/super-admin/owner get full read;
      // GroupAdmin gets §9.3 same-Group sibling-Company scope (multiTenant
      // compliance); self-service checks the lean auth-map identity.
      allow read: if actorIsActive() && (
        isOwnerIdentity() || isSuperAdmin() || isAdmin()
        || groupAdminCanRead(resource.data)
        || isSelfServiceAttendanceWrite(resource.data)
      );
      // CREATE: self can create own check-in (first of the day), Admin can
      // create any record (existing manual-entry flow preserved), and
      // GroupAdmin can create a manual record for an employee within their
      // own Group (§9.3 same-Group scope — isAdmin() only matches the
      // literal 'Admin' role, so GroupAdmin needs its own explicit branch,
      // same fix class as the Stock create rule above). Uses the lean
      // actorRoleMatches('Admin') instead of isAdmin() — the latter's only
      // extra value (isOwnerIdentity()/isSuperAdmin() bypass) is already
      // covered by this clause's own first two branches.
      // Identity guard: self-service must write their own employeeId.
      allow create: if actorIsActive() && (
        isOwnerIdentity()
        || isSuperAdmin()
        || actorRoleMatches('Admin')
        || attendanceGroupAdminScope(request.resource.data)
        || (
          isSelfServiceAttendanceWrite(request.resource.data)
          && request.resource.data.date is string && request.resource.data.date.size() > 0
        )
      );
      // UPDATE: single clause covering Admin, GroupAdmin, self-service, and
      // Admin-correction. Merged into one rule to stay within Firestore's
      // 1000-expression budget.
      // Four write paths:
      //   1. Owner/SuperAdmin — unrestricted
      //   2. Admin — unrestricted for non-GPS fields; GPS evidence changes
      //      (checkIn/checkOut) require a correction with mandatory reason
      //      (Phase 15 hardening — closes the silent-modification loophole)
      //   3. GroupAdmin — same-Group scope (attendanceGroupAdminScope, plus
      //      an explicit groupId-unchanged check since the lean helper only
      //      takes one side), same GPS-evidence-reason guard as Admin
      //   4. Self-service — identity-anchored, checkIn/checkOut immutable
      allow update: if actorIsActive() && (
        isOwnerIdentity() || isSuperAdmin()
        || (
          (
            actorRoleMatches('Admin')
            || (
              attendanceGroupAdminScope(resource.data)
              && (!hasGroupId(request.resource.data) || request.resource.data.groupId == resource.data.groupId)
            )
          )
          && requiresGPSReason(request.resource.data, resource.data)
        )
        || (
          isSelfServiceAttendanceWrite(resource.data)
          && (
            !resource.data.keys().hasAny(['checkIn'])
            || request.resource.data.diff(resource.data).affectedKeys().hasAny(['checkIn']) == false
          )
          && (
            !resource.data.keys().hasAny(['checkOut'])
            || request.resource.data.diff(resource.data).affectedKeys().hasAny(['checkOut']) == false
          )
        )
      );
      // DELETE: always denied (consistent with house soft-delete convention).
      allow delete: if false;
    }

    // ── Phase 1 (Multi-Tenant) — groups / group_members ────────────────
    // Deliberate Phase 1 rules (data-model foundation only — NOT the Phase 2
    // Group Admin authorization). In Phase 1 nothing client-side reads these
    // collections (resolveWriteGroupId() resolves the company→group map from
    // the companies list, never a groups read; the backfill and the Phase 1
    // verification script use the Admin SDK, which bypasses rules by design).
    // Super Admin/owner only, delete always forbidden. Phase 2 (§9.3) extends
    // these blocks with the additive-OR sameGroup() pattern for Group Admins;
    // until then nothing is granted beyond the platform tier.
    match /groups/{groupId} {
      // Phase 2 (§9.3): a Group Admin may read their OWN Group's document
      // (path segment == authoritative actorGroupId), Active-gated per §9.6.
      // They cannot enumerate other Groups, and create/update/delete remain
      // platform-tier (Group Admin "cannot create another Group" — §4).
      allow read: if actorIsActive() && (isOwnerIdentity() || isSuperAdmin()
        || (isGroupAdmin() && groupId == actorGroupId() && groupIsActive(groupId)));
      allow create: if actorIsActive() && (isOwnerIdentity() || isSuperAdmin())
        && request.resource.data.id == groupId;
      allow update: if actorIsActive() && (isOwnerIdentity() || isSuperAdmin())
        && resource.data.id == groupId && request.resource.data.id == groupId;
      allow delete: if false;
    }

    match /group_members/{memberId} {
      // Phase 2 (§9.3): a Group Admin may read the membership records of their
      // own Group (member docs carry groupId; sameGroup() + Active gate).
      // Writes stay platform-tier — a Group Admin can never fabricate or
      // modify membership (incl. their own): "cannot add themselves to another
      // Group", "cannot modify another Group's membership" (test matrix).
      allow read: if actorIsActive() && (isOwnerIdentity() || isSuperAdmin() || groupAdminCanRead(resource.data));
      // Phase 5 (§7.9, §3.1): an existing ACTIVE Group Admin may grant a
      // SECOND Group Admin for their own Group (self-service Group Admins
      // table). The member doc's groupId must be the actor's own Group
      // (never another Group), the Group must be Active, the grant must be
      // anchored to the actor (grantedBy == currentUserId()), and the target
      // can never be the actor themself (no self-grant). Owner/Super Admin
      // platform grant is unchanged. Revoke (update) stays platform-tier.
      allow create: if actorIsActive()
        && request.resource.data.id == memberId
        && request.resource.data.groupId is string && request.resource.data.groupId.size() > 0
        && request.resource.data.userId is string && request.resource.data.userId.size() > 0
        && (
          isOwnerIdentity() || isSuperAdmin()
          || (
            actorIsGroupAdmin()
            && groupIsActive(request.resource.data.groupId)
            && request.resource.data.groupId == actorGroupId()
            && request.resource.data.role == 'GroupAdmin'
            && request.resource.data.status == 'Active'
            && request.resource.data.grantedBy == currentUserId()
            && request.resource.data.userId != currentUserId()
          )
        );
      allow update: if actorIsActive() && (isOwnerIdentity() || isSuperAdmin())
        && resource.data.id == memberId && request.resource.data.id == memberId
        && request.resource.data.groupId == resource.data.groupId
        && request.resource.data.userId == resource.data.userId;
      allow delete: if false;
    }

    // ── Face Attendance + DeepFace Master Plan, Phase 3 — biometric_face_references ──
    // §9's data model, §5's threat model, §11's authorization model, implemented
    // verbatim.
    //
    // Expression-budget note (live-verified 2026-08-26): an EARLIER version of
    // this block used the same per-collection-helper style as `employees`/
    // `attendance` (isGroupAdmin() ternary + separate canCreateCompanyScoped()/
    // groupAdminCanCreate()/actorUserId()/actorRoleMatches() calls) and hit
    // Firestore's 1000-expression cap on every create/update — each of those
    // helpers independently re-derives the actor's identity via its own
    // get(authMapPath())/get(users/{id}) chain, and stacking several of them
    // (needed here because this collection, uniquely among the sensitive
    // collections, has a self-service branch on TOP of the Admin/HR/GroupAdmin
    // branches) multiplied past the cap. Rewritten below using the pattern
    // this file already proves works for an equally-multi-branch rule —
    // `settingsCreateAllowed()`/`settingsUpdateAllowed()` (the `settings`
    // collection, above) — binding `authMap`/`actor` ONCE per allow-clause via
    // `let` and reusing those two values for every self/company/group/role
    // check that clause needs, instead of re-deriving identity per branch.

    // Minimal structural validation (Phase 3 "malformed document denial"
    // requirement) — deliberately lean (direct type/enum checks only, no deep
    // schema library — matching this file's established house style of
    // hasCompanyId()-shaped guards rather than full JSON-schema validation) so
    // a document missing/mistyping a security-relevant field is rejected at
    // create time rather than silently accepted.
    function hasValidBiometricReferenceShape(data) {
      return data.userId is string && data.userId.size() > 0
        && data.companyId is string && data.companyId.size() > 0
        && data.embedding is list && data.embedding.size() > 0
        && data.embeddingModel is string && data.embeddingModel.size() > 0
        && data.detectorBackend is string && data.detectorBackend.size() > 0
        && data.status in ['active', 'revoked']
        && data.enrolledBy is string && data.enrolledBy.size() > 0;
    }

    function biometricReadAllowed(data) {
      let authMap = get(authMapPath()).data;
      let actor = get(/databases/$(database)/documents/users/$(authMap.userId)).data;
      let ownerOrSuper = isOwnerIdentity() || actor.get('isSuperAdmin', false) == true;
      let isSelf = hasCompanyId(data) && data.companyId == authMap.companyId && data.userId == authMap.userId;
      // Deliberately EXCLUDES Director — unlike `employees`' own read grant
      // (which includes Director's view-only executive visibility), biometric
      // embedding data is a materially more sensitive category than typical
      // business records, and neither §9 nor §11 of the master plan grants
      // Director (or any role beyond Admin/HR) any biometric access —
      // "reads are restricted to the minimum required actors" is honored
      // literally, not by copying `employees`' broader read list wholesale.
      let sameCo = ownerOrSuper || (hasCompanyId(data) && data.companyId == authMap.companyId && companyGroupIsActive(data));
      let sameGrp = ownerOrSuper || (actor.role == 'GroupAdmin' && hasGroupId(data)
        && authMap.keys().hasAny(['groupId']) && authMap.groupId is string && data.groupId == authMap.groupId && groupIsActive(data.groupId));
      return ownerOrSuper
        || isSelf
        || (sameCo && (actor.role == 'Admin' || actor.role == 'HR'))
        || sameGrp;
    }

    function biometricCreateAllowed(data) {
      let authMap = get(authMapPath()).data;
      let actor = get(/databases/$(database)/documents/users/$(authMap.userId)).data;
      let ownerOrSuper = isOwnerIdentity() || actor.get('isSuperAdmin', false) == true;
      // Anchors enrolledBy/createdBy/updatedBy to the actor's OWN real
      // identity — a caller can never claim a different acting identity than
      // their own, closing the "forge createdBy/updatedBy identity" attack
      // this phase's threat model requires closed. Mirrors actorUserId()'s
      // owner-pseudo-id convention exactly, but computed once via `let`.
      let actorUid = isOwnerIdentity() ? 'owner:' + request.auth.uid : authMap.userId;
      let identityAnchored = data.enrolledBy == actorUid && data.createdBy == actorUid && data.updatedBy == actorUid;
      let isSelf = data.userId == actorUid;
      let sameCo = ownerOrSuper || (hasCompanyId(data) && data.companyId == authMap.companyId && companyGroupIsActive(data));
      let sameGrp = actor.role == 'GroupAdmin' && hasGroupId(data)
        && authMap.keys().hasAny(['groupId']) && authMap.groupId is string && data.groupId == authMap.groupId && groupIsActive(data.groupId);
      return identityAnchored
        && hasValidBiometricReferenceShape(data)
        && groupIdMatchesCompany(data)
        && ((sameCo && (isSelf || actor.role == 'Admin' || actor.role == 'HR')) || sameGrp);
    }

    function biometricUpdateAllowed(oldData, newData) {
      let authMap = get(authMapPath()).data;
      let actor = get(/databases/$(database)/documents/users/$(authMap.userId)).data;
      let ownerOrSuper = isOwnerIdentity() || actor.get('isSuperAdmin', false) == true;
      let actorUid = isOwnerIdentity() ? 'owner:' + request.auth.uid : authMap.userId;
      // Forever-immutable anchor fields (§9's data model), enforced
      // unconditionally — including for the Owner/SuperAdmin branch,
      // deliberately stricter than this file's usual unrestricted break-glass
      // bypass: re-pointing userId/companyId/groupId on an existing biometric
      // reference would silently reassign one person's stored face to a
      // DIFFERENT employee's identity, which no legitimate operation ever
      // needs (a genuine identity change is always a new document via
      // create, never an update). enrolledAt/enrolledBy anchor the ORIGINAL
      // enrollment event permanently — re-enrollment events are recorded in
      // `history` instead (§9's retention policy), never by overwriting
      // these two fields.
      //
      // Phase 8 addition (Face Attendance + DeepFace Master Plan, §5's threat
      // table: "Stale verification result reused for a later check-in |
      // Verification result is bound to a single attendance write attempt
      // (short-lived server-side token/nonce, consumed once)"): `lastVerifiedAt`
      // joins this client-write-forbidden set too. §9's original field table
      // documented it as "not a security control" — Phase 8 deliberately
      // repurposes it as the anti-replay anchor `AttendanceService.checkIn()`/
      // `checkOut()` re-reads before accepting a `source: 'biometric'` claim
      // (see that file's `validateBiometricVerificationClaim()`). That anchor
      // is only trustworthy if NO client-SDK write — self, Admin, HR,
      // GroupAdmin, or Owner/SuperAdmin — can ever set it; only the Admin-SDK
      // verification flow (`api/_lib/biometrics/verification.ts`, which
      // bypasses these rules entirely) may. Adding it here has zero effect on
      // that flow (Admin SDK never evaluates this file) and only closes the
      // client-side forgery gap.
      let immutableUnchanged = !newData.diff(oldData).affectedKeys().hasAny(
        ['id', 'userId', 'companyId', 'groupId', 'enrolledAt', 'enrolledBy', 'schemaVersion', 'lastVerifiedAt']
      );
      let isSelf = hasCompanyId(oldData) && oldData.companyId == authMap.companyId && oldData.userId == authMap.userId;
      // Self-service updates (re-enrollment) may never touch revocation
      // state — §9/§11: revocation is Admin/HR-triggered or automatic
      // (Phase 9's deactivation hook), never self-service. An employee
      // re-enrolling their own face cannot use the same write to un-revoke
      // themselves or hide a revocation.
      let selfExcludesRevocation = !newData.diff(oldData).affectedKeys().hasAny(['status', 'revokedAt', 'revokedBy']);
      let sameCo = hasCompanyId(oldData) && oldData.companyId == authMap.companyId && companyGroupIsActive(oldData);
      let sameGrp = actor.role == 'GroupAdmin' && hasGroupId(oldData)
        && authMap.keys().hasAny(['groupId']) && authMap.groupId is string && oldData.groupId == authMap.groupId && groupIsActive(oldData.groupId)
        && hasGroupId(newData) && newData.groupId == authMap.groupId;
      return immutableUnchanged
        && newData.updatedBy == actorUid
        && (
          ownerOrSuper
          || (sameCo && (actor.role == 'Admin' || actor.role == 'HR'))
          || sameGrp
          || (isSelf && selfExcludesRevocation)
        );
    }

    match /biometric_face_references/{referenceId} {
      allow read: if actorIsActive() && biometricReadAllowed(resource.data);
      allow create: if actorIsActive()
        && request.resource.data.id == referenceId
        && biometricCreateAllowed(request.resource.data);
      allow update: if actorIsActive() && biometricUpdateAllowed(resource.data, request.resource.data);
      // DELETE: always denied (§9's retention policy: soft-revoke via
      // `status`, never hard-delete — consistent with this file's house
      // soft-delete convention for every other sensitive collection).
      allow delete: if false;
    }

    match /{collectionId}/{documentId} {
      // F-13: the generic fallback also requires an active actor. (Note: the
      // emulator counts expressions without short-circuiting across the
      // matching blocks, so this predicate is evaluated even for collections
      // excluded by isSpecialCollection() — kept deliberately lean.)
      // Phase 2 (§9.3): the additive-OR GroupAdmin pattern lands on the
      // fallback so every current AND future non-special collection gains
      // Group Admin scope without a per-collection edit. F-02's
      // isSpecialCollection() guard sits BEFORE the OR (sequencing per §9.3),
      // so the 14 protected collections can never inherit fallback coverage.
      allow read: if actorIsActive() && !isSpecialCollection(collectionId)
        && (canReadCompanyScoped() || groupAdminCanRead(resource.data));
      allow create: if actorIsActive() && !isSpecialCollection(collectionId)
        && (canCreateCompanyScoped() || groupAdminCanCreate(request.resource.data));
      allow update: if actorIsActive() && !isSpecialCollection(collectionId)
        && (canUpdateCompanyScoped() || groupAdminCanUpdate(resource.data));
      allow delete: if false;
    }
  }
}
