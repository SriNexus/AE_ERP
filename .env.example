# Local development
VITE_FIREBASE_API_KEY=your_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_auth_domain_here
VITE_FIREBASE_PROJECT_ID=your_project_id_here
VITE_FIREBASE_STORAGE_BUCKET=your_storage_bucket_here
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id_here
VITE_FIREBASE_APP_ID=your_app_id_here
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id_here
VITE_USE_FIREBASE_EMULATOR=false
VITE_FIRESTORE_EMULATOR_HOST=127.0.0.1
VITE_FIRESTORE_EMULATOR_PORT=8080
VITE_AUTH_EMULATOR_URL=http://127.0.0.1:9099
VITE_STORAGE_EMULATOR_HOST=127.0.0.1
VITE_STORAGE_EMULATOR_PORT=9199

# Preview
# Configure the same variables in the preview environment before running the built app.

# Production deployment
# Configure these variables in the hosting provider or deployment pipeline.

# ── REST API (Server-side) ──────────────────────────────────────
# Firebase Admin SDK service account key (JSON string escaped for .env)
# Required by the REST API at /api/*
# Get this from Firebase Console → Project Settings → Service Accounts → Generate New Private Key
FIREBASE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"your-project-id",...}

# API keys for machine-to-machine access (comma-separated)
# Used by the REST API via X-API-Key header
API_KEYS=your-api-key-1,your-api-key-2

# Default company ID for API key authentication
# Required when using API key auth (no user context)
API_COMPANY_ID=your-company-id

# ── AI / Intelligence (Phase 9D) ──────────────────────────────
# At least one AI provider must be configured for LLM-powered features.
# If neither is set, AI runs in MOCK/demo mode.
# Get your OpenAI API key from: https://platform.openai.com/api-keys
# Get your Gemini API key from: https://aistudio.google.com/apikey
VITE_OPENAI_API_KEY=
VITE_GEMINI_API_KEY=
