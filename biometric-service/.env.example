# Face Attendance + DeepFace Master Plan, Phase 1 — environment-driven
# configuration for the standalone biometric inference service.
# Copy to .env (gitignored) for local runs; never commit real secrets.

DEEPFACE_RECOGNITION_MODEL=ArcFace
# yunet, not retinaface: Phase 1 benchmark measured >100x faster detection
# with equivalent correctness on the same no-face/multi-face test fixtures.
# See the master plan's Phase 1 record. mediapipe currently fails to load
# with mediapipe==1.0.1 installed (dependency incompatibility).
DEEPFACE_DETECTOR_BACKEND=yunet
DEEPFACE_ANTI_SPOOFING_ENABLED=true

# Left unset in Phase 1: Neozy's own security threshold is NOT locked here.
# See app/config.py — when unset, DeepFace's own model-reported threshold is
# used as-is; Phase 11's real benchmark decides the final Neozy override.
# DEEPFACE_VERIFY_THRESHOLD=

# Service-to-service authentication (Master Plan Section 13). Required in
# any shared/deployed environment.
DEEPFACE_SERVICE_AUTH_TOKEN=

# Local development / Phase 1 test suite ONLY. Never set true in a shared
# or deployed environment.
DEEPFACE_AUTH_DISABLED_FOR_LOCAL_DEV=false

DEEPFACE_INFERENCE_TIMEOUT_SECONDS=30
DEEPFACE_MIN_FACE_SIZE_PX=60
DEEPFACE_MIN_QUALITY_CONFIDENCE=0.85

# Required on Windows to avoid DeepFace's internal logger crashing on an
# emoji character under the default cp1252 stdout encoding (Phase 1 finding
# — see the master plan's Phase 1 record).
PYTHONUTF8=1
